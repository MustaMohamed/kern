#!/usr/bin/env bash
# kern SessionStart: resets or keeps mode state, then prints the kernel, the settings summary and
# the active voice rules. Plain stdout is added to Claude's context.
# shellcheck disable=SC1091 # the libraries are followed under shellcheck -x
# Homebrew bash 5.3.15 segfaults now and then when a subshell undoes a locale change, but only while
# neither LANG nor LC_ALL is set (Task 16l). An unset LANG already means the C locale, and an LC_* still
# overrides it, so exporting LANG=C changes no locale: it only takes the trigger away from this hook and
# every command it runs. It comes first, before anything that could crash.
[ -n "${LANG-}${LC_ALL-}" ] || export LANG=C
KERN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export KERN_ROOT
# Every git call this hook makes, and every git its children run, gets no fsmonitor program and no repo
# hooks, so a repository's own config cannot run code through a kern hook (git 2.31+ reads
# GIT_CONFIG_COUNT). The two pairs go after the pairs the environment already holds, which still apply
# (a container's safe.directory, for one). KERN_GC is their number; a count that is not a number of
# at most 9 digits counts as none.
case "${GIT_CONFIG_COUNT-}" in "" | *[!0-9]* | ??????????*) KERN_GC=0 ;; *) KERN_GC=$((10#$GIT_CONFIG_COUNT)) ;; esac
export GIT_CONFIG_COUNT=$((KERN_GC + 2)) "GIT_CONFIG_KEY_$KERN_GC=core.fsmonitor" "GIT_CONFIG_VALUE_$KERN_GC=false" \
  "GIT_CONFIG_KEY_$((KERN_GC + 1))=core.hooksPath" "GIT_CONFIG_VALUE_$((KERN_GC + 1))=/dev/null"
# POSIXLY_CORRECT in the environment starts bash in POSIX mode, where a "." that fails exits the
# shell before "|| no_lib" runs.
set +o posix

# no_lib NAME: library NAME did not load. Says so in the context and stops. PreToolUse loads each of
# these libraries except render.sh, so without one of them its guards ask on every call.
no_lib() {
  case "$1" in
    render.sh) printf 'kern did not load: hooks/lib/render.sh is missing or broken; reinstall kern\n' ;;
    *) printf 'kern did not load: hooks/lib/%s is missing or broken; guards ask on every call; reinstall kern\n' "$1" ;;
  esac
  exit 0
}

# need LIB FUNCTION...: LIB counts as not loaded unless it defined every FUNCTION.
need() {
  local lib="$1" f
  shift
  for f in "$@"; do
    declare -F "$f" >/dev/null || no_lib "$lib"
  done
}

# shellcheck source=hooks/lib/json.sh
. "$KERN_ROOT/hooks/lib/json.sh" || no_lib json.sh
# shellcheck source=hooks/lib/settings.sh
. "$KERN_ROOT/hooks/lib/settings.sh" || no_lib settings.sh
# shellcheck source=hooks/lib/state.sh
. "$KERN_ROOT/hooks/lib/state.sh" || no_lib state.sh
# shellcheck source=hooks/lib/render.sh
. "$KERN_ROOT/hooks/lib/render.sh" || no_lib render.sh
# Every function each library defines. A bats test keeps these lists equal to the definitions.
need json.sh json_get json_get_raw json_escape json_ok ti_get
need settings.sh kern_main_root _settings_walk_root _settings_files _settings_lookup _settings_read _settings_ignored
need settings.sh _settings_local_ok
need settings.sh settings_get settings_unread_why settings_source settings_keys settings_known_keys settings_unknown_keys
need settings.sh policy_for kern_enabled list_has
need state.sh state_dir _state_path state_file state_get state_set _state_put now_iso default_voice state_reset
need state.sh state_ensure autopilot_denied_by autopilot_on
need state.sh prompt_hashes prompt_consent consent_key consent_for
need render.sh render_template kern_version mode_line autopilot_text settings_summary

# git_note: one line when git is older than 2.31, the first git that reads the GIT_CONFIG_* pairs
# exported above, or when `git version` fails or prints no version; nothing for git 2.31 or later.
git_note() {
  local out major minor
  out=$(git version 2>/dev/null) || out=""
  out=${out%%$'\n'*}
  case "$out" in
    "git version "[0-9]*.[0-9]*)
      major=${out#git version }
      minor=${major#*.}
      major=${major%%.*}
      minor=${minor%%[!0-9]*}
      ;;
    *) major="" minor="" ;;
  esac
  case "$major" in "" | *[!0-9]* | ?????*) major="" ;; esac
  case "$minor" in "" | *[!0-9]* | ?????*) major="" ;; esac
  if [ -z "$major" ]; then
    printf '%s\n' "kern: git version failed or printed no version, so git may ignore kern's GIT_CONFIG_* hardening and a repository's fsmonitor program may run on kern's index reads; install git 2.31 or later."
  elif [ "$major" -lt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -lt 31 ]; }; then
    printf '%s\n' "kern: git $major.$minor is older than 2.31, so git ignores kern's GIT_CONFIG_* hardening and a repository's fsmonitor program can run on kern's index reads; install git 2.31 or later."
  fi
  return 0
}

# env_export: appends `export CLAUDE_PLUGIN_ROOT='<root>'` to $CLAUDE_ENV_FILE, the file whose lines
# Claude Code runs ahead of each Bash tool command, so a skill's `bash ${CLAUDE_PLUGIN_ROOT}/scripts/<name>`
# runs as written. Claude Code names an absolute path in its session-env folder and makes the folder, not
# the file: a path that does not exist yet is written when its folder is writable, an existing one only
# when it is a writable regular file. A relative path or a symlink is never Claude Code's, so it is left
# alone. The value is single-quoted, each ' written as '\''. Nothing else goes to that file, and a failed
# open prints nothing.
env_export() {
  local f="${CLAUDE_ENV_FILE-}" q="'"
  case "$f" in /*) ;; *) return 0 ;; esac
  [ -L "$f" ] && return 0
  if [ -e "$f" ]; then
    if [ ! -f "$f" ] || [ ! -w "$f" ]; then return 0; fi
  elif [ ! -d "$(dirname "$f")" ] || [ ! -w "$(dirname "$f")" ]; then
    return 0
  fi
  printf 'export CLAUDE_PLUGIN_ROOT=%s\n' "$q${KERN_ROOT//$q/$q\\$q$q}$q" 2>/dev/null >>"$f"
  return 0
}

# shellcheck disable=SC2034 # read by the json.sh functions
KERN_INPUT=$(cat)
SID=$(json_get session_id) || SID=""
SOURCE=$(json_get source) || SOURCE=startup
CWD=$(json_get cwd) || CWD="$PWD"
KERN_MAIN=$(kern_main_root "$CWD" 2>/dev/null) || KERN_MAIN=""
export CWD KERN_MAIN
kern_enabled || exit 0

if [ -n "$SID" ]; then
  case "$SOURCE" in
    # The state is kept, even when a read of it fails; a session with no state file gets the default.
    compact | resume) state_ensure "$SID" ;;
    *) state_reset "$SID" ;;
  esac
fi
# Other sessions' state files, and temp files a failed write left, go after 30 days untouched. A
# symlinked state dir is left alone. An id with glob characters, such as "[", can make "! -name"
# exclude nothing, but state_file rejects such ids, so none of them owns a file here.
STATE_DIR=$(state_dir)
if [ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ]; then
  find "$STATE_DIR" -maxdepth 1 -type f \( -name '*.state' -o -name '.state.*' \) -mtime +30 \
    ! -name "$SID.state" -delete >/dev/null 2>&1
fi

K_VERSION=$(kern_version)
K_ROOT="$KERN_ROOT"
K_KERN="$KERN_ROOT/skills"
if [ -n "$SID" ]; then
  K_MODE=$(mode_line "$SID")
  K_AUTOPILOT=$(autopilot_text "$SID")
else
  K_MODE="kern mode: voice=$(default_voice) surface=$(settings_get mode.surface auto) autopilot=off"
  K_AUTOPILOT=off
fi
K_SETTINGS=$(settings_summary)
export K_VERSION K_ROOT K_KERN K_MODE K_AUTOPILOT K_SETTINGS
env_export
render_template "$KERN_ROOT/kernel/kernel.md"
git_note
case "$K_MODE" in
  *voice=terse*) printf '\n' && cat "$KERN_ROOT/modes/terse.md" ;;
esac
exit 0
