#!/usr/bin/env bash
# kern PreToolUse dispatcher: runs every guard in hooks/guards and prints the strictest vote.
# shellcheck disable=SC1091 # the libraries are followed under shellcheck -x
KERN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export KERN_ROOT
# Every git call this hook makes, and every git its children run, gets no fsmonitor program and no repo
# hooks, so a repository's own config cannot run code through a kern hook (git 2.31+ reads
# GIT_CONFIG_COUNT). The two pairs go after the pairs the environment already holds, which still apply
# (a container's safe.directory, for one). KERN_GC is their number; a count that is not a number of
# at most 9 digits counts as none.
case "${GIT_CONFIG_COUNT-}" in "" | *[!0-9]* | ??????????*) KERN_GC=0 ;; *) KERN_GC=$((10#$GIT_CONFIG_COUNT)) ;; esac
export GIT_CONFIG_COUNT=$((KERN_GC + 2)) "GIT_CONFIG_KEY_$KERN_GC=core.fsmonitor" "GIT_CONFIG_VALUE_$KERN_GC=false" \
  "GIT_CONFIG_KEY_$((KERN_GC + 1))=core.hooksPath" "GIT_CONFIG_VALUE_$((KERN_GC + 1))=/dev/null"
# POSIXLY_CORRECT in the environment starts bash in POSIX mode, where a "." that fails exits the
# shell before "|| no_lib" runs.
set +o posix

# no_lib NAME: library NAME did not load, so no guard can run. Prints the decision without any
# library: ask, or deny under bypassPermissions, where an ask might not stop the call. Reads the hook
# input, which nothing has read yet. An ask reason opens as decide.sh's KERN_ASK_PREFIX does.
no_lib() {
  local d=ask p='needs user approval: '
  grep -Eq '"permission_mode"[[:space:]]*:[[:space:]]*"bypassPermissions"' && d=deny p=''
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s","permissionDecisionReason":"%skern G0: hook library %s did not load; reinstall kern"}}\n' \
    "$d" "$p" "$1"
  exit 0
}

# need LIB FUNCTION...: LIB counts as not loaded unless it defined every FUNCTION.
need() {
  local lib="$1" f
  shift
  for f in "$@"; do
    declare -F "$f" >/dev/null || no_lib "$lib"
  done
}

# shellcheck source=hooks/lib/json.sh
. "$KERN_ROOT/hooks/lib/json.sh" || no_lib json.sh
# shellcheck source=hooks/lib/settings.sh
. "$KERN_ROOT/hooks/lib/settings.sh" || no_lib settings.sh
# shellcheck source=hooks/lib/state.sh
. "$KERN_ROOT/hooks/lib/state.sh" || no_lib state.sh
# shellcheck source=hooks/lib/decide.sh
. "$KERN_ROOT/hooks/lib/decide.sh" || no_lib decide.sh
# shellcheck source=hooks/lib/aliases.sh
. "$KERN_ROOT/hooks/lib/aliases.sh" || no_lib aliases.sh
# shellcheck source=hooks/lib/gitctx.sh
. "$KERN_ROOT/hooks/lib/gitctx.sh" || no_lib gitctx.sh
# Every function each library defines, so a truncated library fails closed for the guards too. A
# bats test keeps these lists equal to the definitions.
need json.sh json_get json_get_raw json_escape json_ok ti_get
need settings.sh kern_main_root _settings_files _settings_lookup _settings_read _settings_ignored _settings_local_ok
need settings.sh settings_get settings_source settings_keys settings_known_keys settings_unknown_keys policy_for kern_enabled list_has
need state.sh state_dir _state_path state_file state_get state_set _state_put now_iso default_voice state_reset
need state.sh state_ensure autopilot_denied_by autopilot_on
need state.sh prompt_hashes
need decide.sh vote fail_closed emit_decision
need gitctx.sh git_words _subst_bodies _split_words _shell_words _cmd_words cmd_mod cmd_plain git_sub cmd_head in_main_checkout
need gitctx.sh current_branch base_branch_name branch_protected push_targets with_timeout gh_sub word_value word_has
need aliases.sh alias_snapshot _alias_key _alias_table aliases_load alias_text _alias_var alias_expand

# unparseable WHAT: fail closed on input the JSON reader could not parse, and stop.
unparseable() {
  fail_closed "$1 not parseable"
  emit_decision
  exit 0
}

# shellcheck disable=SC2034 # KERN_INPUT, TOOL and AGENT are read by json.sh and the guard files
KERN_INPUT=$(cat)
SID=$(json_get session_id 2>/dev/null) || SID=""
# cwd is read first because settings, and so autopilot, resolve from it.
CWD=$(json_get cwd)
cwd_rc=$?
[ "$cwd_rc" = 0 ] || CWD="$PWD"
KERN_MAIN=$(kern_main_root "$CWD" 2>/dev/null) || KERN_MAIN=""
export CWD KERN_MAIN
# shellcheck disable=SC2034 # AUTOPILOT is read by emit_decision and the guard files
{
  AUTOPILOT=0
  [ -n "$SID" ] && autopilot_on "$SID" 2>/dev/null && AUTOPILOT=1
}
# shellcheck disable=SC2034 # TOOL is read by guard files
if ! json_ok || ! TOOL=$(json_get tool_name); then
  unparseable "hook input"
fi
[ "$cwd_rc" = 2 ] && unparseable cwd
# Exit 1 is an absent field and takes the fallback; any other failure is malformed JSON and fails closed.
# shellcheck disable=SC2034 # read by ti_get and the guard files
TOOL_INPUT=$(json_get_raw tool_input) || case $? in 1) TOOL_INPUT="{}" ;; *) unparseable tool_input ;; esac
# shellcheck disable=SC2034 # read by guard files
AGENT=$(json_get agent_type) || case $? in 1) AGENT="" ;; *) unparseable agent_type ;; esac
# Monitor runs a shell command from the same `command` key, so every guard reads it as Bash.
[ "$TOOL" = Monitor ] && TOOL=Bash
kern_enabled || exit 0
# The shell's aliases that run git or gh, so git_words judges `gp` as `git push` too.
[ "$TOOL" = Bash ] && aliases_load
# The expansions in this command, which G2, G3, G4, G13, G14 and G15 read with its text before they parse it.
# shellcheck disable=SC2034 # read by the guard files
{
  KERN_ALIAS_TEXT=""
  [ -n "${KERN_ALIASES-}" ] && KERN_ALIAS_TEXT=$(alias_text "$(ti_get command 2>/dev/null)")
}

# The guards kern ships, so a missing guard file fails closed. A guard file that does not source to
# the end fails closed too, and its guard does not run.
KERN_GUARD_IDS="g00 g01 g02 g03 g04 g05 g06 g13 g14 g15 g16 g18 g20"
ids=" $KERN_GUARD_IDS "
bad=" "
for f in "$KERN_ROOT"/hooks/guards/g*.sh; do
  id=$(basename "$f" .sh)
  id=${id%%-*}
  case "$ids" in *" $id "*) ;; *) ids="$ids$id " ;; esac
  # shellcheck source=/dev/null
  . "$f" || bad="$bad$id "
done
for id in $ids; do
  if [ -n "${KERN_GUARDS-}" ] && [ -n "${BATS_TEST_FILENAME-}" ]; then
    case ",$KERN_GUARDS," in *",$id,"*) ;; *) continue ;; esac
  fi
  case "$bad" in *" $id "*) fail_closed "guard $id did not load"; continue ;; esac
  declare -F "guard_$id" >/dev/null || { fail_closed "guard $id did not load"; continue; }
  "guard_$id"
done
emit_decision
exit 0
