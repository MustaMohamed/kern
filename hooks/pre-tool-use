#!/usr/bin/env bash
# kern PreToolUse dispatcher: runs every guard in hooks/guards and prints the strictest vote.
# shellcheck disable=SC1091 # the libraries are followed under shellcheck -x
KERN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export KERN_ROOT
# shellcheck source=hooks/lib/json.sh
. "$KERN_ROOT/hooks/lib/json.sh"
# shellcheck source=hooks/lib/settings.sh
. "$KERN_ROOT/hooks/lib/settings.sh"
# shellcheck source=hooks/lib/state.sh
. "$KERN_ROOT/hooks/lib/state.sh"
# shellcheck source=hooks/lib/decide.sh
. "$KERN_ROOT/hooks/lib/decide.sh"
# shellcheck source=hooks/lib/gitctx.sh
. "$KERN_ROOT/hooks/lib/gitctx.sh"

# unparseable WHAT: fail closed on input the JSON reader could not parse, and stop.
unparseable() {
  fail_closed "$1 not parseable"
  emit_decision
  exit 0
}

# shellcheck disable=SC2034 # KERN_INPUT, TOOL and AGENT are read by json.sh and the guard files
KERN_INPUT=$(cat)
SID=$(json_get session_id 2>/dev/null) || SID=""
# cwd is read first because settings, and so autopilot, resolve from it.
CWD=$(json_get cwd)
cwd_rc=$?
[ "$cwd_rc" = 0 ] || CWD="$PWD"
KERN_MAIN=$(kern_main_root "$CWD" 2>/dev/null) || KERN_MAIN=""
export CWD KERN_MAIN
# shellcheck disable=SC2034 # AUTOPILOT is read by emit_decision and the guard files
{
  AUTOPILOT=0
  [ -n "$SID" ] && autopilot_on "$SID" 2>/dev/null && AUTOPILOT=1
}
# shellcheck disable=SC2034 # TOOL is read by guard files
if ! json_ok || ! TOOL=$(json_get tool_name); then
  unparseable "hook input"
fi
[ "$cwd_rc" = 2 ] && unparseable cwd
# Exit 1 is an absent field and takes the fallback; any other failure is malformed JSON and fails closed.
# shellcheck disable=SC2034 # read by ti_get and the guard files
TOOL_INPUT=$(json_get_raw tool_input) || case $? in 1) TOOL_INPUT="{}" ;; *) unparseable tool_input ;; esac
# shellcheck disable=SC2034 # read by guard files
AGENT=$(json_get agent_type) || case $? in 1) AGENT="" ;; *) unparseable agent_type ;; esac
# Monitor runs a shell command from the same `command` key, so every guard reads it as Bash.
[ "$TOOL" = Monitor ] && TOOL=Bash
kern_enabled || exit 0

for f in "$KERN_ROOT"/hooks/guards/g*.sh; do
  # shellcheck source=/dev/null
  . "$f"
done
for f in "$KERN_ROOT"/hooks/guards/g*.sh; do
  id=$(basename "$f" .sh)
  id=${id%%-*}
  if [ -n "${KERN_GUARDS-}" ] && [ -n "${BATS_TEST_FILENAME-}" ]; then
    case ",$KERN_GUARDS," in *",$id,"*) ;; *) continue ;; esac
  fi
  declare -F "guard_$id" >/dev/null || { fail_closed "guard $id did not load"; continue; }
  "guard_$id"
done
emit_decision
exit 0
