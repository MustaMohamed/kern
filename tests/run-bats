#!/usr/bin/env bash
# Runs bats with /bin/bash first on PATH on macOS, so hooks are tested on the bash 3.2 they meet there.
# --jobs N (first argument): runs each .bats file under the given directories or files as its own bats
# process, N at a time, with xargs -P; no GNU parallel needed. Every test keeps its own BATS_TEST_TMPDIR,
# HOME and plugin data dir, so files share no state. Each file's TAP output is printed whole, in file order,
# and the run fails when any file fails.
set -euo pipefail
# bash 3.2 does not fail a test on a false [[ ]] unless it is the test's last command, so every
# [[ ]] assertion must end with || false. Refuse to run while a bare one exists.
root=$(cd "$(dirname "$0")/.." && pwd)
bare=$(find "$root/tests" -name '*.bats' -exec grep -nHE '^[[:space:]]+\[\[ .* \]\][[:space:]]*$' {} + || true)
if [ -n "$bare" ]; then
  echo "end each [[ ]] assertion with || false:" >&2
  printf '%s\n' "$bare" >&2
  exit 1
fi
jobs=1
if [ "${1-}" = --jobs ]; then
  jobs=${2-}
  case "$jobs" in '' | *[!0-9]* | 0) echo "run-bats: --jobs needs a positive number" >&2; exit 2 ;; esac
  shift 2
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
if [ "$(uname)" = Darwin ] && [ -x /bin/bash ]; then
  mkdir "$work/shim"
  ln -s /bin/bash "$work/shim/bash"
  PATH="$work/shim:$PATH"
fi
if [ "$jobs" = 1 ]; then
  bats "$@"
  exit $?
fi
# One line per .bats file, in sorted order; a directory names every .bats file directly inside it, as bats does.
for a in "$@"; do
  if [ -d "$a" ]; then
    find "$a" -maxdepth 1 -name '*.bats' | LC_ALL=C sort
  else
    printf '%s\n' "$a"
  fi
done >"$work/files"
[ -s "$work/files" ] || { echo "run-bats: no .bats files" >&2; exit 2; }
n=0
while IFS= read -r f; do
  n=$((n + 1))
  printf '%s\t%s\n' "$n" "$f"
done <"$work/files" >"$work/list"
export work
# Each file: its TAP into out.<n>, its exit status into rc.<n>.
tr '\t\n' '\0\0' <"$work/list" | xargs -0 -n 2 -P "$jobs" sh -c 'bats "$2" >"$work/out.$1" 2>&1; echo $? >"$work/rc.$1"' sh
status=0
while IFS="$(printf '\t')" read -r i f; do
  printf '# file %s\n' "$f"
  cat "$work/out.$i"
  rc=$(cat "$work/rc.$i" 2>/dev/null || echo 1)
  [ "$rc" = 0 ] || { status=1; printf '# FAILED: %s (exit %s)\n' "$f" "$rc"; }
done <"$work/list"
exit "$status"
