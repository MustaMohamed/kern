 need decide.sh vote fail_closed emit_decision
 need gitctx.sh git_words _subst_bodies _split_words _shell_words _cmd_words git_sub cmd_head in_main_checkout
 need gitctx.sh current_branch base_branch_name branch_protected push_targets with_timeout gh_sub word_value word_has
-need aliases.sh alias_snapshot aliases_load alias_expand
+need aliases.sh alias_snapshot aliases_load alias_text alias_expand
 
 # unparseable WHAT: fail closed on input the JSON reader could not parse, and stop.
 unparseable() {
@@ -95,6 +95,12 @@ AGENT=$(json_get agent_type) || case $? in 1) AGENT="" ;; *) unparseable agent_t
 kern_enabled || exit 0
 # The shell's aliases that run git or gh, so git_words judges `gp` as `git push` too.
 [ "$TOOL" = Bash ] && aliases_load
+# The expansions in this command, which G2, G3, G4, G13, G14 and G15 read with its text before they parse it.
+# shellcheck disable=SC2034 # read by the guard files
+{
+  KERN_ALIAS_TEXT=""
+  [ -n "${KERN_ALIASES-}" ] && KERN_ALIAS_TEXT=$(alias_text "$(ti_get command 2>/dev/null)")
+}
 
 # The guards kern ships, so a missing guard file fails closed. A guard file that does not source to
 # the end fails closed too, and its guard does not run.
diff --git a/tests/hooks/aliases.bats b/tests/hooks/aliases.bats
index 6327ec2..df93dfb 100644
--- a/tests/hooks/aliases.bats
+++ b/tests/hooks/aliases.bats
@@ -275,3 +275,22 @@ noalias_hook() {
   run env _KA_7878='git push --force' bash "$(kern_root)/hooks/pre-tool-use" <<<"$(bash_payload "xx origin main")"
   [ "$(decision_of "$output")" = none ]
 }
+
+@test "an alias is not skipped by a guard that reads the command text first: gh, push, a deploy or a protected host" {
+  snap "alias -- prc='gh pr create'" "alias -- rel='gh release create'" "alias -- isc='gh issue create'" \
+    "alias -- prv='gh pr review'" "alias -- up='git push'"
+  mkdir -p "$R/.claude"
+  printf 'deploy.envs: production\n' >"$R/.claude/kern.local.yml"
+  expect deny "prc --title t --body b"
+  same "prc --title t --body b" "gh pr create --title t --body b"
+  same "rel v1" "gh release create v1"
+  same "isc --title t --body-file b.md" "gh issue create --title t --body-file b.md"
+  same "prv 1 --approve" "gh pr review 1 --approve"
+  same "up origin production" "git push origin production"
+  expect ask "rel v1" "isc --title t --body-file b.md"
+  snap "alias -- pdb='git status && psql -h prod-db.internal -c '\\''DELETE FROM x'\\'''"
+  printf 'protected_targets: prod-db.internal\n' >"$R/.claude/kern.local.yml"
+  # G13 cannot find the alias's psql in the command text, so it also reads it as fed by a pipe.
+  expect deny "pdb"
+  [[ "$output" == *"statement starting \`delete\` is not a read"* ]] || false
+}
