alias -- 'gpf!'='echo EXPANDED'
alias -- _='nice '
alias -- n='nice '
alias -- a='nice '
alias -- b='nohup '
alias -- c='env '
alias -- t=$'nice\t'
alias -- sudo='nocorrect sudo'
alias -- s2='sudo '
run() { print -rn -- "[$1] -> "; eval "$1" 2>&1 | head -1; }
run '_ X=1 gpf! origin'
run "_ 'gpf!' origin"
run 'a b c gpf! origin'
run 't gpf! origin'
run '_ _ _ _ _ _ _ _ _ gpf! origin'
run 'n n n n n n n n n n n n gpf! origin'
run 'noglob gpf! origin'
run 'nocorrect gpf! origin'
run 'command gpf! origin'
run 'builtin gpf! origin'
run 'exec gpf! origin'
run '- gpf! origin'
run 'repeat 1 gpf! origin'
run 'time gpf! origin'
run '_ nocorrect gpf! origin'
run '_ X=1 env gpf! origin'
run 'X=1 _ gpf! origin'
run '_ 2>/dev/null gpf! origin'
run '_ >/dev/null gpf! origin'
run '_ ; gpf! origin'
alias -L t
alias -L _
