+// tests/licensing.test.mjs
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, existsSync } from 'node:fs';
+
+const read = (p) => readFileSync(new URL(`../${p}`, import.meta.url), 'utf8');
+
+function upstreamRows() {
+  return read('UPSTREAM.md').split('\n')
+    .filter((l) => /^\| [a-z]+ \|/.test(l))
+    .map((l) => l.split('|').slice(1, -1).map((c) => c.trim()));
+}
+
+test('kern itself is MIT', () => {
+  assert.match(read('LICENSE'), /^MIT License\n\nCopyright \(c\) 2026 Mustafa Mohamed/);
+});
+
+test('every upstream source has a licence file and a NOTICE entry', () => {
+  const rows = upstreamRows();
+  assert.deepEqual(rows.map((r) => r[0]).sort(), ['addy', 'caveman', 'pocock', 'pstack', 'superpowers']);
+  const notice = read('NOTICE');
+  for (const [key, , , , copyright, , url] of rows) {
+    assert.ok(existsSync(new URL(`../licenses/${key}.LICENSE`, import.meta.url)), `licenses/${key}.LICENSE`);
+    assert.ok(notice.includes(url), `NOTICE names ${url}`);
+    assert.ok(notice.includes(copyright), `NOTICE carries "${copyright}"`);
+  }
+});
+
+test('NOTICE reproduces caveman NOTICE verbatim', () => {
+  assert.ok(read('NOTICE').includes(read('licenses/caveman.NOTICE').trim()));
+});
+
+test('caveman licence is Apache-2.0', () => {
+  assert.match(read('licenses/caveman.LICENSE'), /Apache License\s+Version 2\.0, January 2004/);
+});
+
+test('NOTICE has a file map section', () => {
+  assert.match(read('NOTICE'), /^## File map$/m);
+});
diff --git a/tests/lint-rules.test.mjs b/tests/lint-rules.test.mjs
new file mode 100644
index 0000000..685ccca
--- /dev/null
+++ b/tests/lint-rules.test.mjs
@@ -0,0 +1,121 @@
+// tests/lint-rules.test.mjs
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { parseFrontmatter } from '../scripts/lib/frontmatter.mjs';
+import { loadModel, runLint } from '../scripts/lib/lint-rules.mjs';
+
+function repo(files) {
+  const root = mkdtempSync(join(tmpdir(), 'kern-lint-'));
+  for (const [p, content] of Object.entries(files)) {
+    mkdirSync(join(root, p, '..'), { recursive: true });
+    writeFileSync(join(root, p), content);
+  }
+  return root;
+}
+const skill = (name, fm, body = '\n# x\n\n## Steps\n\n1. a\n') => `---\nname: ${name}\n${fm}\n---\n${body}`;
+const lint = (files) => runLint(loadModel(repo(files)));
+const rules = (findings) => findings.filter((f) => f.level === 'error').map((f) => f.rule);
+
+test('parses CRLF frontmatter', () => {
+  const r = parseFrontmatter('---\r\nname: a\r\ndescription: Use when x.\r\n---\r\nbody');
+  assert.equal(r.error, null);
+  assert.equal(r.data.name, 'a');
+  assert.equal(r.body.trim(), 'body');
+});
+
+test('strips quotes and keeps colons in values', () => {
+  const r = parseFrontmatter('---\nname: a\ndescription: "Use when: x happens"\n---\n');
+  assert.equal(r.data.description, 'Use when: x happens');
+});
+
+test('block scalars are an error', () => {
+  const r = parseFrontmatter('---\nname: a\ndescription: >\n  folded\n---\n');
+  assert.match(r.error, /single-line/);
+});
+
+test('tiers: auto, path when a kernel row routes to it, else slash', () => {
+  const manual = 'description: d\ndisable-model-invocation: true';
+  const root = repo({
+    'skills/a/SKILL.md': skill('a', 'description: Use when x.'),
+    'skills/p/SKILL.md': skill('p', manual),
+    'skills/s/SKILL.md': skill('s', manual),
+    'kernel/kernel.md': '| New behaviour | Read {KERN}/p/SKILL.md |\n',
+  });
+  const tiers = Object.fromEntries(loadModel(root).skills.map((x) => [x.name, x.tier]));
+  assert.deepEqual(tiers, { a: 'auto', p: 'path', s: 'slash' });
+});
+
+test('a clean auto skill passes', () => {
+  assert.deepEqual(lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x happens.') }), []);
+});
+
+test('rule 1: missing frontmatter, name mismatch, non-kebab dir', () => {
+  assert.deepEqual(rules(lint({ 'skills/a/SKILL.md': '# no frontmatter' })), [1]);
+  assert.deepEqual(rules(lint({ 'skills/a/SKILL.md': skill('b', 'description: Use when x.') })), [1]);
+  assert.deepEqual(rules(lint({ 'skills/Bad_Dir/SKILL.md': skill('Bad_Dir', 'description: Use when x.') })), [1]);
+});
+
+test('rule 2: unknown skill key and ignored plugin-agent keys', () => {
+  assert.deepEqual(rules(lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.\ncolour: red') })), [2]);
+  const agent = '---\nname: r\ndescription: d\npermissionMode: plan\n---\nbody\n';
+  assert.deepEqual(rules(lint({ 'agents/r.md': agent })), [2]);
+});
+
+test('rule 3: auto limit and trigger, manual limit, agent limit, totals', () => {
+  const long = 'Use when ' + 'x'.repeat(300);
+  assert.deepEqual(rules(lint({ 'skills/a/SKILL.md': skill('a', `description: ${long}`) })), [3]);
+  assert.deepEqual(rules(lint({ 'skills/a/SKILL.md': skill('a', 'description: Does things.') })), [3]);
+  const manual = `description: ${'y'.repeat(121)}\ndisable-model-invocation: true`;
+  assert.deepEqual(rules(lint({ 'skills/a/SKILL.md': skill('a', manual) })), [3]);
+  const agent = `---\nname: r\ndescription: ${'z'.repeat(151)}\n---\nbody\n`;
+  assert.deepEqual(rules(lint({ 'agents/r.md': agent })), [3]);
+  const files = {};
+  for (let i = 0; i < 6; i++) files[`skills/s${i}/SKILL.md`] = skill(`s${i}`, `description: Use when ${'w'.repeat(280)}`);
+  assert.ok(rules(lint(files)).includes(3), 'auto total over 1,500');
+});
+
+test('rule 4: referenced files must exist', () => {
+  const body = '\n## Steps\n\n1. Read `references/missing.md` and `${CLAUDE_PLUGIN_ROOT}/kernel/none.md`.\n';
+  const f = lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.', body) });
+  assert.deepEqual(rules(f), [4, 4]);
+});
+
+test('rule 8: machine paths and listed names in shipped files', () => {
+  process.env.KERN_LINT_NAMES = 'Zebediah';
+  const body = '\n## Steps\n\n1. Open /Users/someone/x and ask Zebediah.\n';
+  const f = lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.', body) });
+  delete process.env.KERN_LINT_NAMES;
+  assert.deepEqual(rules(f), [8, 8]);
+});
+
+test('rule 10: exemption needs a reason, and suppresses its finding', () => {
+  const bad = { 'skills/a/SKILL.md': skill('a', 'description: Does things.'), 'scripts/lint-exemptions.json': '[{"rule":3,"path":"skills/a/SKILL.md","reason":""}]' };
+  assert.deepEqual(rules(lint(bad)), [3, 10], 'an exemption without a reason suppresses nothing');
+  const ok = { ...bad, 'scripts/lint-exemptions.json': '[{"rule":3,"path":"skills/a/SKILL.md","reason":"fixture"}]' };
+  assert.deepEqual(rules(lint(ok)), []);
+});
+
+test('rule 11: long dashes and curly quotes', () => {
+  const body = '\n## Steps\n\n1. Do this — then “that”.\n';
+  assert.deepEqual(rules(lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.', body) })), [11, 11]);
+});
+
+test('rule 11: scans any non-binary shipped file, skips binaries', () => {
+  assert.deepEqual(rules(lint({ 'hooks/lib/x.mjs': '// a — b\n' })), [11]);
+  const f = lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.'), 'skills/a/logo.png': 'a — b' });
+  assert.deepEqual(rules(f), []);
+});
+
+test('rule 4: existing references pass, repo-root fallback, anchors and ./', () => {
+  const ok = '\n## Steps\n\n1. Read `references/ok.md` and `${CLAUDE_PLUGIN_ROOT}/kernel/k.md`.\n';
+  assert.deepEqual(lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.', ok), 'skills/a/references/ok.md': 'x', 'kernel/k.md': 'x' }), []);
+  const root = '\n## Steps\n\n1. Run `scripts/tool`.\n';
+  assert.deepEqual(lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.', root), 'scripts/tool': 'x' }), []);
+  const anchors = '\n## Steps\n\n1. See `references/ok.md#part`, `./references/ok.md` and [x](references/ok.md#x).\n';
+  assert.deepEqual(lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.', anchors), 'skills/a/references/ok.md': 'x' }), []);
+  const bad = '\n## Steps\n\n1. See `references/missing.md#part`.\n';
+  assert.deepEqual(rules(lint({ 'skills/a/SKILL.md': skill('a', 'description: Use when x.', bad) })), [4]);
+});
diff --git a/tests/route-eval.test.mjs b/tests/route-eval.test.mjs
new file mode 100644
index 0000000..b6924a2
--- /dev/null
+++ b/tests/route-eval.test.mjs
@@ -0,0 +1,125 @@
+// tests/route-eval.test.mjs
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { buildCorpus, rank } from '../scripts/lib/rank.mjs';
+import { evaluate } from '../scripts/route-eval.mjs';
+
+const skill = (name, desc) => `---\nname: ${name}\ndescription: ${desc}\n---\n\n## Steps\n\n1. a\n`;
+function repo(files) {
+  const root = mkdtempSync(join(tmpdir(), 'kern-eval-'));
+  for (const [p, c] of Object.entries(files)) {
+    mkdirSync(join(root, p, '..'), { recursive: true });
+    writeFileSync(join(root, p), typeof c === 'string' ? c : JSON.stringify(c));
+  }
+  return root;
+}
+const caseFile = (name, positive, negative) => ({
+  skill_name: name,
+  trigger: { positive: positive.map((prompt) => ({ prompt, top_k: 3 })), negative: negative.map((prompt) => ({ prompt })) },
+  evals: [{ id: 1, kind: 'dialogue', prompt: 'x', expected_output: 'y', expectations: ['z'] }],
+});
+
+test('rank orders by shared vocabulary', () => {
+  const c = buildCorpus([{ name: 'tests', text: 'run failing tests suite' }, { name: 'deploy', text: 'deploy release production' }]);
+  assert.equal(rank('my tests are failing', c)[0].name, 'tests');
+});
+
+test('zero-score prompt is an error, not a crash', () => {
+  const root = repo({
+    'skills/a/SKILL.md': skill('a', 'Use when greeting kern hello'),
+    'evals/cases/a.json': caseFile('a', ['hello kern', 'greeting kern', 'qqq zzz'], ['deploy prod', 'weather today']),
+    'evals/distractors.json': [],
+    'evals/baseline.json': { min_rank1: 0 },
+  });
+  const r = evaluate(root, { minRank1: 0 });
+  assert.equal(r.errors.length, 1);
+  assert.match(r.errors[0], /shares no vocabulary/);
+});
+
+test('auto skill without a case file is an error', () => {
+  const root = repo({ 'skills/a/SKILL.md': skill('a', 'Use when greeting kern'), 'evals/distractors.json': [], 'evals/baseline.json': { min_rank1: 0 } });
+  assert.match(evaluate(root, { minRank1: 0 }).errors[0], /no eval case file/);
+});
+
+test('below minimums is an error', () => {
+  const root = repo({
+    'skills/a/SKILL.md': skill('a', 'Use when greeting kern hello'),
+    'evals/cases/a.json': caseFile('a', ['hello kern'], ['deploy prod']),
+    'evals/distractors.json': [],
+    'evals/baseline.json': { min_rank1: 0 },
+  });
+  assert.ok(evaluate(root, { minRank1: 0 }).errors.some((e) => /below required minimums/.test(e)));
+});
+
+test('a distractor that outranks the skill fails the positive', () => {
+  const root = repo({
+    'skills/a/SKILL.md': skill('a', 'Use when greeting kern hello or showing a plan'),
+    'evals/cases/a.json': { ...caseFile('a', [], []), trigger: { positive: [{ prompt: 'write a plan for tasks', top_k: 1 }, { prompt: 'hello kern', top_k: 3 }, { prompt: 'greeting kern', top_k: 3 }], negative: [{ prompt: 'deploy prod' }, { prompt: 'weather today' }] } },
+    'evals/distractors.json': [{ name: 'writing-plans', description: 'Use when writing a plan for multi-step tasks' }],
+    'evals/baseline.json': { min_rank1: 0 },
+  });
+  const errors = evaluate(root, { minRank1: 0 }).errors;
+  assert.ok(errors.some((e) => /positive prompt ranked #2/.test(e)), errors.join('\n'));
+});
+
+test('rank-1 rate below the baseline fails', () => {
+  const root = repo({
+    'skills/a/SKILL.md': skill('a', 'Use when greeting kern hello'),
+    'evals/cases/a.json': caseFile('a', ['hello kern', 'greeting kern', 'kern hello there'], ['deploy prod', 'weather today']),
+    'evals/distractors.json': [],
+    'evals/baseline.json': { min_rank1: 100 },
+  });
+  assert.deepEqual(evaluate(root, { minRank1: 100 }).errors, []);
+  assert.equal(evaluate(root, { minRank1: 101 }).errors.length, 1);
+});
+
+const POS = ['hello kern', 'greeting kern', 'kern hello there'];
+const NEG = ['deploy prod', 'weather today'];
+const two = (da, db, extra = {}) => repo({
+  'skills/a/SKILL.md': skill('a', da),
+  'skills/b/SKILL.md': skill('b', db),
+  'evals/cases/a.json': caseFile('a', POS, NEG),
+  'evals/cases/b.json': caseFile('b', POS, NEG),
+  'evals/distractors.json': [],
+  'evals/baseline.json': { min_rank1: 0 },
+  ...extra,
+});
+
+test('collision between two auto skills is an error', () => {
+  const r = evaluate(two('Use when greeting kern hello', 'Use when greeting kern hello'), { minRank1: 0 });
+  assert.ok(r.errors.some((e) => /collision: /.test(e)), r.errors.join('\n'));
+});
+
+test('overlap between descriptions is a warning', () => {
+  // similarity 0.62: between COLLISION_WARN 0.5 and COLLISION_ERROR 0.75
+  const r = evaluate(two('Use when greeting kern hello version', 'Use when greeting kern hello installed'), { minRank1: 0 });
+  assert.ok(r.warnings.some((w) => /overlap: /.test(w)), r.warnings.join('\n'));
+  assert.ok(!r.errors.some((e) => /collision: /.test(e)), r.errors.join('\n'));
+});
+
+const withNegatives = (negative) => repo({
+  'skills/a/SKILL.md': skill('a', 'Use when greeting kern hello'),
+  'evals/cases/a.json': { ...caseFile('a', POS, []), trigger: { positive: POS.map((prompt) => ({ prompt, top_k: 3 })), negative } },
+  'evals/distractors.json': [{ name: 'writing-plans', description: 'Use when writing a plan for multi-step tasks' }],
+  'evals/baseline.json': { min_rank1: 0 },
+});
+
+test('skill ranked #1 for a negative prompt is an error', () => {
+  const r = evaluate(withNegatives([{ prompt: 'greeting kern hello' }, { prompt: 'weather today' }]), { minRank1: 0 });
+  assert.ok(r.errors.some((e) => /ranked #1 for negative prompt/.test(e)), r.errors.join('\n'));
+});
+
+test('declared owner must outrank the skill', () => {
+  const ok = evaluate(withNegatives([{ prompt: 'write a plan for tasks', owner: 'writing-plans' }, { prompt: 'weather today' }]), { minRank1: 0 });
+  assert.ok(!ok.errors.some((e) => /owner /.test(e)), ok.errors.join('\n'));
+  const bad = evaluate(withNegatives([{ prompt: 'greeting kern hello', owner: 'writing-plans' }, { prompt: 'weather today' }]), { minRank1: 0 });
+  assert.ok(bad.errors.some((e) => /owner .* does not outrank it/.test(e)), bad.errors.join('\n'));
+});
+
+test('unknown owner is an error', () => {
+  const r = evaluate(withNegatives([{ prompt: 'weather today', owner: 'nope' }, { prompt: 'deploy prod' }]), { minRank1: 0 });
+  assert.ok(r.errors.some((e) => /unknown owner "nope"/.test(e)), r.errors.join('\n'));
+});
diff --git a/tests/scripts/fetch-upstream.bats b/tests/scripts/fetch-upstream.bats
