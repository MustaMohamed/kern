+  run_guard "$(tool_payload Bash "\"command\":\"git commit -m \\\"\$(cat <<'EOF'\\nfix: x\\necho on > $S/test-session.state\\nEOF\\n)\\\"\"")" g16
+  [ "$status" -eq 0 ]
+  [ "$(decision_of "$output")" = none ]
+}
