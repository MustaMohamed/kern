diff --git a/hooks/guards/g04-untrusted.sh b/hooks/guards/g04-untrusted.sh
index a196cf8..d8899f7 100644
--- a/hooks/guards/g04-untrusted.sh
+++ b/hooks/guards/g04-untrusted.sh
@@ -1,6 +1,6 @@
 # shellcheck shell=bash
 # G4 untrusted text: PR, issue, review and release text goes through a file, never inline in the
-# command. Option tables and _gh_* helpers are in g02-pr.sh and g03-review.sh.
+# command. The gh api option table and the _gh_* helpers are in g03-review.sh and g02-pr.sh.
 
 guard_g04() {
   [ "$TOOL" = Bash ] || return 0
@@ -27,35 +27,57 @@ $(git_words "$cmd")
 EOT
 }
 
-# _g04_text RECORD SUB: inline text on a pr, issue or release command. pr create, review and comment
-# are read with their option tables, which catch clusters such as -abTEXT. Every verb is also
-# scanned word by word for --body, and for -b where it is the body flag (not pr checkout's branch or
-# issue develop's base) and release's --notes and -n, attached forms included.
+# _g04_text RECORD SUB: inline text on a pr, issue or release command. Each verb that takes text has
+# its text flag (b --body, n --notes, c --comment) and its boolean short flags, from gh 2.100.0
+# `--help`. A word is inline text when it is the long flag (`--x` or `--x=`), or a short cluster
+# that reaches the letter through boolean letters only: -b, -bTEXT, -b=TEXT, -wbTEXT. --body on any
+# pr or issue verb counts too. pr checkout's -b (a branch) and issue develop's -b (a base) are not
+# text.
 _g04_text() {
-  local table="" toks w hit=0
+  local spec letter bools long w hit=0
   case "$2" in
-    "pr create") table=$_GH_CREATE_OPTS ;;
-    "pr review") table=$_GH_REVIEW_OPTS ;;
-    "pr comment") table=$_GH_COMMENT_OPTS ;;
+    "pr create") spec="b defw" ;;
+    "pr merge") spec="b dmrs" ;;
+    "pr review") spec="b acr" ;;
+    "pr comment" | "issue create" | "issue comment") spec="b ew" ;;
+    "pr edit" | "issue edit") spec="b -" ;;
+    "pr close") spec="c d" ;;
+    "pr reopen" | "issue close" | "issue reopen") spec="c -" ;;
+    "release create") spec="n dp" ;;
+    "release edit") spec="n -" ;;
+    *) spec="" ;;
   esac
-  if [ -n "$table" ]; then
-    toks=$(_gh_args "$1" 2 | _gh_opts "$table")
-    _gh_last "$toks" body >/dev/null && hit=1
-  fi
+  letter=${spec%% *}
+  bools=${spec#* }
+  case "$letter" in b) long=--body ;; n) long=--notes ;; c) long=--comment ;; *) long="" ;; esac
   while IFS= read -r w; do
     case "$w" in --body | --body=*) case "$2" in "pr "* | "issue "*) hit=1 ;; esac ;; esac
-    case "$2" in
-      "pr create" | "pr edit" | "pr merge" | "pr review" | "pr comment" | "issue create" | "issue comment" | "issue edit")
-        case "$w" in -b*) hit=1 ;; esac
-        ;;
-      "release create" | "release edit")
-        case "$w" in --notes | --notes=* | -n*) hit=1 ;; esac
-        ;;
-    esac
+    [ -n "$letter" ] || continue
+    case "$w" in "$long" | "$long="*) hit=1 ;; esac
+    _g04_cluster "$w" "$letter" "$bools" && hit=1
   done <<EOT
 $(_shell_words "$1")
 EOT
-  [ "$hit" = 1 ] && vote deny G4 "pass PR, issue, review and release text with --body-file or --notes-file <file>, not inline"
+  [ "$hit" = 1 ] || return 0
+  if [ "$letter" = c ]; then
+    vote deny G4 "a close or reopen --comment is inline text; post it with gh pr|issue comment --body-file <file>"
+  else
+    vote deny G4 "pass PR, issue, review and release text with --body-file or --notes-file <file>, not inline"
+  fi
+}
+
+# _g04_cluster WORD LETTER BOOLS: WORD is a short-option cluster that reaches LETTER with only
+# letters from BOOLS before it.
+_g04_cluster() {
+  local w c
+  case "$1" in --* | -) return 1 ;; -*) w=${1#-} ;; *) return 1 ;; esac
+  while [ -n "$w" ]; do
+    c=${w%"${w#?}"}
+    [ "$c" = "$2" ] && return 0
+    case "$3" in *"$c"*) ;; *) return 1 ;; esac
+    w=${w#?}
+  done
+  return 1
 }
 
 # _g04_api RECORD: a -f or -F field named body, or ending in [body], read as gh reads the flags
diff --git a/hooks/lib/gitctx.sh b/hooks/lib/gitctx.sh
index 797c55f..89839b3 100644
--- a/hooks/lib/gitctx.sh
+++ b/hooks/lib/gitctx.sh
@@ -442,12 +442,13 @@ with_timeout() {
 }
 
 # gh_sub CMDLINE: for `gh <group> <verb> ...` prints `<group> <verb>`; exit 1 for anything else.
-# What _cmd_words skips comes first. `-R <repo>`, `-R<repo>`, `--repo <repo>` and `--repo=<repo>`
-# before the group or the verb are skipped: gh reads them there too.
+# What _cmd_words skips comes first. The command is gh by its basename in any case (a path, or GH
+# on a case-insensitive file system), as G1 reads it. `-R <repo>`, `-R<repo>`, `--repo <repo>` and
+# `--repo=<repo>` before the group or the verb are skipped: gh reads them there too.
 gh_sub() {
   local out
   out=$(_cmd_words "$1" | awk '
-    NR == 1 { if ($0 != "gh") exit; next }
+    NR == 1 { b = $0; sub(/.*\//, "", b); if (tolower(b) != "gh") exit; next }
     skip { skip = 0; next }
     $0 == "-R" || $0 == "--repo" { skip = 1; next }
     /^-R./ || /^--repo=/ { next }
