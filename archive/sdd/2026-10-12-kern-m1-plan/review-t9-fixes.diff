+          if (d == "\\") { j++; w = w substr(buf, j, 1); continue }
+          if (d == sq || d == "\"") { wq = d; continue }
+          if (index(" \t;&|<>()`", d)) break
+          w = w d
+        }
+        if (w != "") print w
+        i = j - 1
+      }
+    }'
