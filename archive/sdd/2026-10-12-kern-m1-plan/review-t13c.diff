+  done
+  run bash -c '. "$1"; shift; for w in "$@"; do _g15_named "x $w y" || echo "prefilter misses $w"; done' _ "$f" "${names_all[@]}"
+  [ "$status" = 0 ]
+  [ -z "$output" ]
+}
