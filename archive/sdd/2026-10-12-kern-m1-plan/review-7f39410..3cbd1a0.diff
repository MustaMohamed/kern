+}
+
+@test "a found key with a missing or truncated value is 2 with no output" {
+  KERN_INPUT='{"command":'
+  run json_get command
+  [ "$status" -eq 2 ]
+  [ -z "$output" ]
+  KERN_INPUT='{"a":'
+  run json_get_raw a
+  [ "$status" -eq 2 ]
+  [ -z "$output" ]
+  KERN_INPUT='{"a":}'
