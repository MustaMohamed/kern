# Task 5 fix round 1: 8063b92..fe24f3f excluding docs/
fe24f3f M1: make session state fail closed
dfdcc32 M1: any settings layer can deny autopilot (contract update)
diff --git a/hooks/lib/state.sh b/hooks/lib/state.sh
index 0e79f59..f149d1b 100644
--- a/hooks/lib/state.sh
+++ b/hooks/lib/state.sh
@@ -1,72 +1,85 @@
 # shellcheck shell=bash
 # kern session state: one flat `key: value` file per session, written only by kern hooks.
 # Needs settings.sh. Guard G16 denies tool writes under state_dir.
 
 state_dir() {
   printf '%s/sessions\n' "${CLAUDE_PLUGIN_DATA:-$HOME/.claude/plugins/data/kern-kern}"
 }
 
 # state_file SID: path of the session's state file. Exit 2 for an id outside [A-Za-z0-9_-].
 state_file() {
+  local LC_ALL=C
   case "$1" in
     '' | *[!A-Za-z0-9_-]*) return 2 ;;
   esac
   printf '%s/%s.state\n' "$(state_dir)" "$1"
 }
 
 # state_get SID KEY: prints the value. Exit 1 unset, 2 bad id or unsafe file.
 state_get() {
   local f
   f=$(state_file "$1") || return 2
+  [ -L "$(dirname "$f")" ] && return 2
   [ -L "$f" ] && return 2
   [ -f "$f" ] || return 1
   LC_ALL=C awk -v k="$2" 'index($0, k ": ") == 1 { v = substr($0, length(k) + 3); found = 1 }
     END { if (found) { print v; exit 0 } exit 1 }' "$f"
 }
 
 # state_set SID KEY=VALUE...: atomic update (temp file in the same dir, then mv), mode 0600.
 state_set() {
-  local sid="$1" f dir tmp kv k v content
-  shift
+  _state_put 0 "$@"
+}
+
+# _state_put FRESH SID KEY=VALUE...: FRESH=1 starts from empty content, ignoring any old file.
+_state_put() {
+  local fresh="$1" sid="$2" f dir tmp kv k v content
+  shift 2
   f=$(state_file "$sid") || return 2
   dir=$(dirname "$f")
   (umask 077 && mkdir -p "$dir") || return 2
   [ -L "$dir" ] && return 2
   [ -L "$f" ] && return 2
   content=""
-  [ -f "$f" ] && content=$(cat "$f")
+  [ "$fresh" = 0 ] && [ -f "$f" ] && content=$(LC_ALL=C cat "$f")
   for kv in "$@"; do
     k=${kv%%=*}
     v=${kv#*=}
     case "$k" in '' | *[!a-z_]*) return 2 ;; esac
     case "$v" in *"
 "*) return 2 ;; esac
     content=$(printf '%s\n' "$content" | LC_ALL=C awk -v k="$k" 'index($0, k ": ") != 1 && $0 != ""')
     content="$content
 $k: $v"
   done
   tmp=$(umask 077 && mktemp "$dir/.state.XXXXXX") || return 2
-  printf '%s\n' "$content" | sed '/^$/d' >"$tmp" || { rm -f "$tmp"; return 2; }
+  printf '%s\n' "$content" | LC_ALL=C sed '/^$/d' >"$tmp" || { rm -f "$tmp"; return 2; }
   mv -f "$tmp" "$f"
 }
 
 # now_iso: current UTC time, ISO 8601.
 now_iso() {
   date -u +%Y-%m-%dT%H:%M:%SZ
 }
 
 # state_reset SID: defaults from settings, autopilot off.
 state_reset() {
   local voice surface
   voice=$(settings_get mode.voice normal)
   surface=$(settings_get mode.surface auto)
   case "$voice" in normal | terse) ;; *) voice=normal ;; esac
   case "$surface" in chat | auto | html) ;; *) surface=auto ;; esac
-  state_set "$1" "voice=$voice" "surface=$surface" "autopilot=off" "since=$(now_iso)"
+  _state_put 1 "$1" "voice=$voice" "surface=$surface" "autopilot=off" "since=$(now_iso)"
 }
 
-# autopilot_on SID: exit 0 only when no settings layer says `autopilot: denied` and the state says on.
+# autopilot_on SID: exit 0 only when no existing settings layer says `autopilot: denied` and the state says on.
 autopilot_on() {
-  [ "$(settings_get autopilot allowed)" = denied ] && return 1
+  local f
+  while IFS= read -r f; do
+    [ -f "$f" ] || continue
+    [ "$(_settings_lookup "$f" autopilot)" = denied ] && return 1
+  done <<EOT
+$(_settings_files)
+EOT
   [ "$(state_get "$1" autopilot 2>/dev/null)" = on ]
 }
diff --git a/tests/hooks/state.bats b/tests/hooks/state.bats
index 3be0b37..5f62a5a 100644
--- a/tests/hooks/state.bats
+++ b/tests/hooks/state.bats
@@ -56,10 +56,47 @@ autopilot: on"
 @test "autopilot_on needs the state and no denied setting" {
   state_reset s1
   run autopilot_on s1
   [ "$status" -eq 1 ]
   state_set s1 autopilot=on
   autopilot_on s1
   printf 'autopilot: denied\n' >"$HOME/.claude/kern.yml"
   run autopilot_on s1
   [ "$status" -eq 1 ]
 }
+
+@test "autopilot_on is off when any layer denies, even under a higher allowed layer" {
+  state_reset s1
+  state_set s1 autopilot=on
+  mkdir -p "$R/.claude"
+  printf 'autopilot: allowed\n' >"$R/.claude/kern.local.yml"
+  printf 'autopilot: denied\n' >"$HOME/.claude/kern.yml"
+  run autopilot_on s1
+  [ "$status" -ne 0 ]
+}
+
+@test "a symlinked sessions dir is refused on read" {
+  mkdir -p "$BATS_TEST_TMPDIR/elsewhere"
+  printf 'autopilot: on\n' >"$BATS_TEST_TMPDIR/elsewhere/s1.state"
+  ln -s "$BATS_TEST_TMPDIR/elsewhere" "$(state_dir)"
+  run state_get s1 autopilot
+  [ "$status" -eq 2 ]
+  run autopilot_on s1
+  [ "$status" -ne 0 ]
+}
+
+@test "state_reset discards a garbled old file under a UTF-8 locale" {
+  mkdir -p "$(state_dir)"
+  printf 'voice: normal\n\377\377\nautopilot: on\n' >"$(state_file s1)"
+  export LANG=en_US.UTF-8 LC_ALL=
+  run state_reset s1
+  [ "$status" -eq 0 ]
+  run autopilot_on s1
+  [ "$status" -ne 0 ]
+  [ "$(state_get s1 autopilot)" = off ]
+}
+
+@test "session ids are ASCII-only whatever the locale" {
+  export LANG=en_US.UTF-8 LC_ALL=
+  run state_file "é"
+  [ "$status" -eq 2 ]
+}
