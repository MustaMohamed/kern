+  # bnd(S, T, P): S holds the host T, not inside a longer name, followed by :P or ,P when P is set.
+  function bnd(s, t, p,   i, a, l) {
+    l = length(t)
+    while ((i = index(s, t)) > 0) {
+      a = substr(s, i + l, 1)
