+  printf '%s' "$1" | LC_ALL=C awk '
+    BEGIN { for (i = 0; i < 128; i++) hex[sprintf("%04x", i)] = sprintf("%c", i) }
+    { buf = buf (NR > 1 ? "\n" : "") $0 }
+    END {
