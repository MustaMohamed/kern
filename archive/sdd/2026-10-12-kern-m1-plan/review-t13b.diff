+      case "$pre" in *[[:space:]]) pre=${pre%?} ;; *) break ;; esac
+    done
+    case "$pre" in "$p" | *[[:space:]\;\&\|\(\)\{\}]"$p") ;; *) return 0 ;; esac
+  done
+  printf '%s' "$p"
+}
