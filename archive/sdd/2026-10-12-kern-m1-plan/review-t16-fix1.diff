diff --git a/tests/lint-rules.test.mjs b/tests/lint-rules.test.mjs
index e8fc9f1..775b8f6 100644
--- a/tests/lint-rules.test.mjs
+++ b/tests/lint-rules.test.mjs
@@ -166,3 +166,19 @@ test('rule 6: every user-reachable skill is in the help map', () => {
   files['skills/help/references/map.md'] = map + '| `mode` | slash | /kern:mode | voice |\n';
   assert.deepEqual(rules(lint(files)), []);
 });
+
+test('rule 6: a route row in another form, or ## Steps without a numbered list, is an error', () => {
+  const tw = { 'skills/tw/SKILL.md': skill('tw', 'description: d\ndisable-model-invocation: true') };
+  const ticks = lint({ ...tw, 'kernel/kernel.md': kernel(['| Prose | Read `{KERN}/tw/SKILL.md` |']) });
+  assert.deepEqual(rules(ticks), [6]);
+  assert.match(ticks[0].message, /bare/);
+  const trailing = lint({ 'kernel/kernel.md': kernel(['| Prose | Read {KERN}/nope/SKILL.md, then x |']) });
+  assert.deepEqual(rules(trailing), [6]);
+  assert.match(trailing[0].message, /bare/);
+  const bullets = lint({
+    'kernel/kernel.md': kernel(['| Prose | Read {KERN}/tw/SKILL.md |']),
+    'skills/tw/SKILL.md': skill('tw', 'description: d\ndisable-model-invocation: true', '\n# tw\n\n## Steps\n\n- a\n'),
+  });
+  assert.deepEqual(rules(bullets), [6]);
+  assert.match(bullets[0].message, /numbered list/);
+});
diff --git a/tests/skills-help.test.mjs b/tests/skills-help.test.mjs
index fbe5e1d..ba6185d 100644
--- a/tests/skills-help.test.mjs
+++ b/tests/skills-help.test.mjs
@@ -34,3 +34,30 @@ test('the template parses as kern settings and every key in it is documented', (
     assert.ok(table.includes(`| \`${family}\` |`), `${k} is in kernel/settings.md`);
   }
 });
+
+test('check compares keys with kernel/settings.md and names the floor keys the hooks ignore', () => {
+  const check = body.split('## Check')[1];
+  assert.match(check, /kernel\/settings\.md/);
+  assert.match(check, /Do not rely on the kernel's Project settings block/);
+  const table = readFileSync(join(dir, '..', '..', 'kernel', 'settings.md'), 'utf8');
+  const actions = table.match(/Floor actions have no key and never loosen: ([^.]+)\./)[1];
+  assert.ok(check.includes(actions), 'Check names the floor actions as kernel/settings.md lists them');
+  const render = readFileSync(join(dir, '..', '..', 'hooks', 'lib', 'render.sh'), 'utf8');
+  const floor = render.match(/^KERN_FLOOR_KEYS="([^"]+)"/m)[1].split(' ').sort();
+  const named = [...check.matchAll(/`([a-z_]+\.policy)`/g)].map((m) => m[1]).sort();
+  assert.deepEqual(named, floor);
+});
+
+test('setup defers the work dir to kern-dir; allowed-tools covers its read-only calls', () => {
+  const setup = body.split('## Setup')[1].split('\n## ')[0];
+  assert.match(setup, /bash \$\{CLAUDE_PLUGIN_ROOT\}\/scripts\/kern-dir [a-z]/);
+  assert.doesNotMatch(body, /\/\.kern\//);
+  const tools = data['allowed-tools'].split(', ');
+  for (const t of ['Bash(git rev-parse *)', 'Bash(git check-ignore *)', 'Bash(bash ${CLAUDE_PLUGIN_ROOT}/scripts/kern-root *)']) assert.ok(tools.includes(t), t);
+  assert.ok(!tools.some((t) => t.includes('kern-dir')), 'kern-dir writes, so setup step 6 keeps its permission prompt');
+});
+
+test('the template sets no key: every line is a comment or blank', () => {
+  const tpl = readFileSync(join(dir, 'templates', 'kern.local.yml'), 'utf8');
+  assert.doesNotMatch(tpl, /^[^#\n]/m);
+});
