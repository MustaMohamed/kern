diff --git a/scripts/kern-dir b/scripts/kern-dir
index d45e987..11e2c46 100755
--- a/scripts/kern-dir
+++ b/scripts/kern-dir
@@ -1,33 +1,36 @@
 #!/usr/bin/env bash
 # Resolves WORK/<sub> under the main worktree root, creates it, and keeps WORK out of git through
 # .git/info/exclude. Exit 2 when the work dir holds tracked files.
 set -euo pipefail
 KERN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 export KERN_ROOT
 # shellcheck source=hooks/lib/settings.sh
 . "$KERN_ROOT/hooks/lib/settings.sh"
 sub="${1-}"
 case "$sub" in
-  '' | -* | /* | */ | *//* | */-* | *[!a-z0-9/-]*) echo "kern-dir: name must be lowercase segments of letters, digits and dashes, joined by /" >&2; exit 2 ;;
+  '' | -* | :* | /* | */ | *//* | */-* | *[!a-z0-9/-]*) echo "kern-dir: name must be lowercase segments of letters, digits and dashes, joined by /" >&2; exit 2 ;;
 esac
 CWD="$PWD"
 KERN_MAIN=$(kern_main_root "$CWD") || { echo "kern-dir: not a git repository" >&2; exit 2; }
 export CWD KERN_MAIN
 wd=$(settings_get work_dir .kern)
 wd=${wd%/}
 case "$wd" in
-  '' | /* | *..*) echo "kern-dir: work_dir must be a relative path inside the repo, not '$wd'" >&2; exit 2 ;;
+  '' | . | :* | .git | .git* | /* | *..*) echo "kern-dir: work_dir must be a relative path inside the repo, not '.', '.git*' or ':*', got '$wd'" >&2; exit 2 ;;
 esac
 if [ -n "$(git -C "$KERN_MAIN" ls-files -- "$wd")" ]; then
   echo "kern-dir: $wd holds tracked files; set work_dir in .claude/kern.local.yml" >&2
   exit 2
 fi
 common=$(git -C "$KERN_MAIN" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
   common=$(cd "$KERN_MAIN" && cd "$(git rev-parse --git-common-dir)" && pwd)
 mkdir -p "$common/info"
 if ! grep -qxF "/$wd/" "$common/info/exclude" 2>/dev/null; then
+  if [ -s "$common/info/exclude" ] && [ -n "$(tail -c1 "$common/info/exclude")" ]; then
+    printf '\n' >>"$common/info/exclude"
+  fi
   printf '/%s/\n' "$wd" >>"$common/info/exclude"
   echo "kern: added /$wd/ to .git/info/exclude" >&2
 fi
 mkdir -p "$KERN_MAIN/$wd/$sub"
 printf '%s\n' "$KERN_MAIN/$wd/$sub"
diff --git a/tests/scripts/kern-detect.bats b/tests/scripts/kern-detect.bats
index e0cc1f6..1aa495b 100644
--- a/tests/scripts/kern-detect.bats
+++ b/tests/scripts/kern-detect.bats
@@ -57,10 +57,36 @@ setup() {
   [ "${output%%	*}" = '{id}/{slug}' ]
 }
 
 @test "pr.template and an unknown key" {
   mkdir -p .github; printf 't\n' >.github/pull_request_template.md
   run bash "$K/kern-detect" pr.template
   [ "${output%%	*}" = .github/pull_request_template.md ]
   run bash "$K/kern-detect" nope
   [ "$status" -eq 2 ]
 }
+
+@test "the npm init placeholder test script is not a test runner" {
+  printf '{"scripts":{"test":"echo \\"Error: no test specified\\" && exit 1"}}' >package.json
+  run bash "$K/kern-detect" test.full
+  [ "$status" -eq 3 ]
+  [[ "$output" == *"no test specified"* ]] || false
+  run bash "$K/kern-detect" test.focused
+  [ "$status" -eq 3 ]
+  [[ "$output" == *"no test specified"* ]] || false
+}
+
+@test "more than one scripts object in package.json is ambiguous" {
+  printf '{"scripts":{"test":"jest","lint":"x"},"nested":{"scripts":{"test":"y"}}}' >package.json
+  for k in test.full test.focused typecheck lint build; do
+    run bash "$K/kern-detect" "$k"
+    [ "$status" -eq 3 ] || { echo "$k: $status"; false; }
+    [[ "$output" == *"ambiguous: more than one scripts object in package.json"* ]] || false
+  done
+}
+
+@test "test.focused evidence does not claim a path argument works" {
+  printf '{"scripts":{"test":"jest"}}' >package.json
+  run bash "$K/kern-detect" test.focused
+  [ "$status" -eq 0 ]
+  [[ "$output" == *"(path argument not verified)"* ]] || false
+}
