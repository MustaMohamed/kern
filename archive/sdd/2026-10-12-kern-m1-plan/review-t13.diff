diff --git a/hooks/guards/g13-protected.sh b/hooks/guards/g13-protected.sh
new file mode 100644
index 0000000..1c1bba7
--- /dev/null
+++ b/hooks/guards/g13-protected.sh
@@ -0,0 +1,59 @@
+# shellcheck shell=bash
+# G13 protected targets: no copies to, and no mutating SQL against, anything in protected_targets.
+# Reading (SELECT, scp from the target, sftp get) stays allowed.
+
+guard_g13() {
+  [ "$TOOL" = Bash ] || return 0
+  local list cmd seg rest target
+  list=$(settings_get protected_targets '')
+  [ -n "$list" ] || return 0
+  cmd=$(ti_get command) || return 0
+  rest="$list,"
+  while [ -n "$rest" ]; do
+    target=${rest%%,*}
+    rest=${rest#*,}
+    target=$(printf '%s' "$target" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
+    [ -n "$target" ] || continue
+    case "$cmd" in *"$target"*) ;; *) continue ;; esac
+    while IFS= read -r seg; do
+      _g13_segment "$seg" "$target"
+    done <<EOT
+$(git_words "$cmd")
+EOT
+    _g13_sql "$cmd" "$target"
+  done
+}
+
+_g13_segment() {
+  local seg="$1" target="$2" head last
+  head=$(cmd_head "$seg")
+  case "${head%% *}" in
+    scp | rsync)
+      last=$(_shell_words "$seg" | tail -n 1)
+      case "$last" in *"$target"*) vote deny G13 "copy to protected target $target" ;; esac
+      ;;
+    sftp)
+      printf '%s\n' "$seg" | grep -Eiq '(^|[^a-z])(put|rm|rename|mkdir|rmdir|chmod)[[:space:]]' &&
+        vote deny G13 "sftp write to protected target $target"
+      ;;
+    ssh)
+      case "$seg" in *"$target"*) ;; *) return 0 ;; esac
+      _shell_words "$seg" | paste -sd ' ' - | grep -Eq '(^|[[:space:];])(rm|mv|cp|del|copy|move|rename|mkdir|rmdir|touch|tee|chmod|chown|systemctl|service|kill)([[:space:];]|$)|>' &&
+        vote deny G13 "write command over ssh to protected target $target"
+      ;;
+  esac
+}
+
+# _g13_sql CMD TARGET: mutating SQL in the command, or in a file it feeds with -f, --file or <.
+_g13_sql() {
+  local cmd="$1" target="$2" text f
+  text="$cmd"
+  for f in $(printf '%s\n' "$cmd" | grep -Eo '(-f|--file=?|<)[[:space:]]*[^[:space:];|&]+\.sql' | sed -E 's/^(-f|--file=?|<)[[:space:]]*//'); do
+    case "$f" in /*) ;; *) f="$CWD/$f" ;; esac
+    [ -f "$f" ] && text="$text
+$(cat "$f")"
+  done
+  printf '%s\n' "$text" | grep -Eiq '(^|[^a-z_])(insert[[:space:]]+into|update[[:space:]]+[a-z_."`]+[[:space:]]+set|delete[[:space:]]+from|drop[[:space:]]+(table|database|schema|index|view)|alter[[:space:]]+(table|database|schema)|truncate|create[[:space:]]+(table|database|schema|index)|grant[[:space:]]|revoke[[:space:]]|lock[[:space:]]+tables|set[[:space:]]+global|kill[[:space:]]+[0-9])' &&
+    vote deny G13 "mutating SQL against protected target $target"
+  return 0
+}
diff --git a/hooks/guards/g14-tracker.sh b/hooks/guards/g14-tracker.sh
new file mode 100644
index 0000000..4659c8a
--- /dev/null
+++ b/hooks/guards/g14-tracker.sh
@@ -0,0 +1,144 @@
+# shellcheck shell=bash
+# G14 tracker and chat writes: MCP write tools on tracker or chat servers, and gh issue writes.
+# Chat messages are a floor action (messaging people): tracker.policy never makes them auto.
+# An allow approves the whole Bash call, so tracker.policy auto allows a gh write only in the shape
+# _g14_proven accepts (the _gh_* helpers are in g02-pr.sh, _GH_COMMENT_* in g03-review.sh); any
+# other gh write asks.
+
+KERN_G14_TRACKERS="linear jira atlassian asana github gitlab notion monday clickup todoist trello shortcut height zendesk"
+KERN_G14_CHAT="slack gmail discord teams intercom front mail telegram whatsapp"
+KERN_G14_VERBS="create save update delete remove comment post send merge transition move assign archive edit write add set upload submit resolve share invite publish label close reopen mark reply"
+
+# gh option tables for _gh_opts (gh 2.100.0 `--help`), and the options an allowed write may carry.
+# Left out of the safe sets: options that read a local file (attach, recover, a body file outside
+# _gh_file_ok), take the body from elsewhere or inline (template, body: G4 asks for a file), open an
+# editor or a browser, name another repo (repo, and the number-or-URL links), or assign (@copilot
+# starts an agent).
+_GH_ISSUE_CREATE_OPTS="assignee/a/v attach/-/v blocked-by/-/v blocking/-/v body/b/v body-file/F/v \
+editor/e/b label/l/v milestone/m/v parent/-/v project/p/v recover/-/v template/T/v title/t/v type/-/v \
+web/w/b repo/R/v help/h/b"
+_GH_ISSUE_EDIT_OPTS="add-assignee/-/v add-blocked-by/-/v add-blocking/-/v add-label/-/v add-project/-/v \
+add-sub-issue/-/v attach/-/v body/b/v body-file/F/v milestone/m/v parent/-/v remove-assignee/-/v \
+remove-blocked-by/-/v remove-blocking/-/v remove-label/-/v remove-milestone/-/b remove-parent/-/b \
+remove-project/-/v remove-sub-issue/-/v remove-type/-/b title/t/v type/-/v repo/R/v help/h/b"
+_GH_ISSUE_CLOSE_OPTS="comment/c/v duplicate-of/-/v reason/r/v repo/R/v help/h/b"
+_GH_ISSUE_REOPEN_OPTS="comment/c/v repo/R/v help/h/b"
+_GH_ISSUE_LOCK_OPTS="reason/r/v repo/R/v help/h/b"
+_GH_YES_OPTS="yes/-/b repo/R/v help/h/b"
+_GH_REPO_OPTS="repo/R/v help/h/b"
+_GH_LABEL_CREATE_OPTS="color/c/v description/d/v force/f/b repo/R/v help/h/b"
+_GH_LABEL_EDIT_OPTS="color/c/v description/d/v name/n/v repo/R/v help/h/b"
+
+guard_g14() {
+  case "$TOOL" in
+    mcp__*) _g14_mcp ;;
+    Bash) _g14_gh ;;
+  esac
+}
+
+_g14_has_word() {
+  local w
+  for w in $2; do
+    case "$1" in *"$w"*) return 0 ;; esac
+  done
+  return 1
+}
+
+_g14_mcp() {
+  local server action kind="" extra
+  server=$(printf '%s' "${TOOL#mcp__}" | sed 's/__.*//' | tr '[:upper:]' '[:lower:]')
+  action=$(printf '%s' "${TOOL##*__}" | tr '[:upper:]' '[:lower:]' | tr '-' '_')
+  _g14_has_word "$server" "$KERN_G14_CHAT" && kind=chat
+  [ -z "$kind" ] && _g14_has_word "$server" "$KERN_G14_TRACKERS" && kind=tracker
+  extra=$(settings_get mcp.write_servers '' | tr '[:upper:]' '[:lower:]' | tr ',' ' ')
+  [ -z "$kind" ] && [ -n "$extra" ] && _g14_has_word "$server" "$extra" && kind=tracker
+  [ -n "$kind" ] || return 0
+  _g14_is_write "$action" || return 0
+  _g14_decide "$kind" "$TOOL"
+}
+
+# _g14_is_write ACTION: any `_`-separated word of ACTION is a write verb.
+_g14_is_write() {
+  local part
+  for part in $(printf '%s' "$1" | tr '_' ' '); do
+    case " $KERN_G14_VERBS " in *" $part "*) return 0 ;; esac
+  done
+  return 1
+}
+
+# _g14_decide KIND WHAT [PROVEN]: tracker.policy auto allows only when PROVEN is 1 (the default: an
+# MCP tool's shape is its name).
+_g14_decide() {
+  if [ "$AUTOPILOT" = 1 ]; then
+    vote deny G14 "$2 under autopilot: tracker and chat writes stay human"
+    return 0
+  fi
+  if [ "$1" = chat ]; then
+    vote ask G14 "$2 sends a message to people"
+    return 0
+  fi
+  case "$(policy_for tracker)" in
+    auto)
+      if [ "${3:-1}" = 1 ]; then
+        vote allow G14 "tracker.policy auto: $2"
+      else
+        vote ask G14 "$2 in a shape kern cannot check; tracker.policy auto allows only \`gh issue|label <verb>\` alone, in this repo, with literal words and any --body-file in the repo"
+      fi
+      ;;
+    deny) vote deny G14 "tracker.policy deny" ;;
+    *) vote ask G14 "$2 writes to the tracker" ;;
+  esac
+}
+
+_g14_gh() {
+  local cmd sub i=0
+  cmd=$(ti_get command) || return 0
+  _gh_load "$cmd"
+  while [ "$i" -lt "${#_GH_RECS[@]}" ]; do
+    sub=$(gh_sub "${_GH_RECS[$i]}")
+    case "$sub" in
+      "issue create" | "issue comment" | "issue edit" | "issue close" | "issue reopen" | "issue delete" | "issue transfer" | "issue lock" | "label create" | "label edit" | "label delete")
+        if _g14_proven "$i" "$sub"; then
+          _g14_decide tracker "gh $sub" 1
+        else
+          _g14_decide tracker "gh $sub" 0
+        fi
+        ;;
+    esac
+    i=$((i + 1))
+  done
+}
+
+# _g14_proven IDX SUB: the gh record at IDX in _GH_RECS, a SUB write, may be allowed as the whole
+# Bash call: _gh_proven, only SUB's safe options (none names a repo, so -R and --repo fail here), its
+# arguments (none for issue create, one label name for a label verb, else one issue number: a URL
+# may name another repo), and a --body-file that passes _gh_file_ok.
+_g14_proven() {
+  local opts safe toks pos file
+  case "$2" in
+    "issue create") opts=$_GH_ISSUE_CREATE_OPTS; safe="title body-file label milestone project type" ;;
+    "issue comment") opts=$_GH_COMMENT_OPTS; safe=$_GH_COMMENT_SAFE ;;
+    "issue edit")
+      opts=$_GH_ISSUE_EDIT_OPTS
+      safe="title body-file add-label remove-label milestone remove-milestone add-project remove-project type remove-type remove-assignee"
+      ;;
+    "issue close") opts=$_GH_ISSUE_CLOSE_OPTS; safe="reason" ;;
+    "issue reopen") opts=$_GH_ISSUE_REOPEN_OPTS; safe="" ;;
+    "issue delete" | "label delete") opts=$_GH_YES_OPTS; safe="yes" ;;
+    "issue transfer") opts=$_GH_REPO_OPTS; safe="" ;;
+    "issue lock") opts=$_GH_ISSUE_LOCK_OPTS; safe="reason" ;;
+    "label create") opts=$_GH_LABEL_CREATE_OPTS; safe="color description force" ;;
+    "label edit") opts=$_GH_LABEL_EDIT_OPTS; safe="color description name" ;;
+    *) return 1 ;;
+  esac
+  toks=$(_gh_args "${_GH_RECS[$1]}" 2 | _gh_opts "$opts")
+  _gh_proven "$1" "$toks" && _gh_only "$toks" "$safe" || return 1
+  pos=$(_gh_pos "$toks")
+  case "$2" in
+    "issue create") [ -z "$pos" ] || return 1 ;;
+    "label "*) [ -n "$pos" ] && [ "$(printf '%s\n' "$pos" | wc -l)" -eq 1 ] || return 1 ;;
+    *) case "$pos" in "" | *[!0-9]*) return 1 ;; esac ;;
+  esac
+  file=$(_gh_last "$toks" body-file) || file=""
+  [ -z "$file" ] || _gh_file_ok "$file"
+}
diff --git a/hooks/guards/g15-deploy.sh b/hooks/guards/g15-deploy.sh
new file mode 100644
index 0000000..64dc7ee
--- /dev/null
+++ b/hooks/guards/g15-deploy.sh
@@ -0,0 +1,47 @@
+# shellcheck shell=bash
+# G15 deploy and publish: workflow runs, releases, package publishes, infra applies, deploy-branch pushes.
+
+KERN_G15_RE='^(gh (workflow run|release (create|upload|edit|delete))|(npm|pnpm|yarn( npm)?|bun) publish|cargo publish|twine upload|gem push|poetry publish|docker (push|buildx build .*--push)|(terraform|tofu) (apply|destroy|import)|pulumi (up|destroy)|cdk (deploy|destroy)|kubectl (apply|create|delete|replace|patch|rollout|scale|set|edit|annotate|label)|helm (install|upgrade|uninstall|rollback)|(serverless|sls) (deploy|remove)|vercel( .*)? (--prod|deploy)|fly (deploy|apps destroy)|firebase deploy|eb deploy|aws (ecs update-service|lambda update-function-code|cloudformation (deploy|create-stack|update-stack|delete-stack)|s3 (sync|cp|rm|mv) .*s3://))'
+
+guard_g15() {
+  [ "$TOOL" = Bash ] || return 0
+  local cmd seg words parsed dir rest sub t envs
+  cmd=$(ti_get command) || return 0
+  envs=$(settings_get deploy.envs '')
+  while IFS= read -r seg; do
+    words=$(_shell_words "$seg" | awk '!s && /^[A-Za-z_][A-Za-z0-9_]*=/ { next } !s && /^(command|exec|time|nohup|sudo|npx)$/ { next } { s = 1; print }' | paste -sd ' ' -)
+    if printf '%s\n' "$words" | grep -Eq -- "$KERN_G15_RE"; then
+      _g15_vote "$(printf '%s' "$words" | cut -c1-60)"
+      continue
+    fi
+    [ -n "$envs" ] || continue
+    parsed=$(git_sub "$seg") || continue
+    dir=${parsed%%	*}
+    rest=${parsed#*	}
+    sub=${rest%%	*}
+    rest=${rest#*	}
+    [ "$sub" = push ] || continue
+    # On a detached HEAD push_targets prints nothing for a push with no refspec, and an empty line
+    # for HEAD or @; it prints * for --all, --mirror, --branches or a pattern. Each target is
+    # unknown, so it may be a deploy branch.
+    while IFS= read -r t; do
+      if [ -z "$t" ]; then
+        _g15_vote "push from a detached HEAD: the target branch is unknown"
+      elif [ "$t" = '*' ]; then
+        _g15_vote "push of every branch or a pattern may reach a deploy branch"
+      elif list_has "$envs" "$t"; then
+        _g15_vote "push to deploy branch $t"
+      fi
+    done <<EOT
+$(push_targets "$dir" "$rest")
+EOT
+  done <<EOT
+$(git_words "$cmd")
+EOT
+}
+
+_g15_vote() {
+  vote ask G15 "deploy or publish: $1"
+  [ "$AUTOPILOT" = 1 ] && vote deny G15 "deploy or publish under autopilot: $1"
+  return 0
+}
diff --git a/tests/hooks/g13-g15.bats b/tests/hooks/g13-g15.bats
new file mode 100644
index 0000000..79be67e
--- /dev/null
+++ b/tests/hooks/g13-g15.bats
@@ -0,0 +1,143 @@
+#!/usr/bin/env bats
+# G13 protected targets, G14 tracker and chat writes, G15 deploy and publish.
+
+load ../helpers/common
+
+setup() {
+  R="$BATS_TEST_TMPDIR/repo"
+  make_repo "$R"
+  mkdir -p "$R/.claude"
+  kern_env "$R"
+}
+
+g() { run_guard "$(bash_payload "$1")" "$2"; }
+mcp() { run_guard "$(payload PreToolUse "\"tool_name\":\"$1\",\"tool_input\":{}")" g14; }
+
+@test "G13: inactive until protected_targets is set" {
+  g "scp a.txt v1-host:/data/" g13
+  [ "$(decision_of "$output")" = none ]
+}
+
+@test "G13: a copy to the target is denied; a copy from it is not" {
+  printf 'protected_targets: v1-host, prod-db.internal\n' >"$R/.claude/kern.local.yml"
+  g "scp a.txt v1-host:/data/" g13
+  [ "$(decision_of "$output")" = deny ]
+  g "scp v1-host:/data/a.txt ." g13
+  [ "$(decision_of "$output")" = none ]
+}
+
+@test "G13: mutating SQL against the target is denied; SELECT is not" {
+  printf 'protected_targets: prod-db.internal\n' >"$R/.claude/kern.local.yml"
+  g "psql -h prod-db.internal -c 'UPDATE users SET a=1'" g13
+  [ "$(decision_of "$output")" = deny ]
+  g "psql -h prod-db.internal -c 'SELECT count(*) FROM users'" g13
+  [ "$(decision_of "$output")" = none ]
+  printf 'DELETE FROM users;\n' >"$R/fix.sql"
+  g "psql -h prod-db.internal -f fix.sql" g13
+  [ "$(decision_of "$output")" = deny ]
+}
+
+@test "G13: a write over ssh to the target is denied in both modes" {
+  printf 'protected_targets: v1-host\n' >"$R/.claude/kern.local.yml"
+  g "ssh v1-host 'rm -f /data/x'" g13
+  [ "$(decision_of "$output")" = deny ]
+  set_autopilot on
+  g "ssh v1-host 'rm -f /data/x'" g13
+  [ "$(decision_of "$output")" = deny ]
+}
+
+@test "G14: a tracker write asks, a read does not vote, autopilot denies" {
+  mcp mcp__claude_ai_Linear__save_issue
+  [ "$(decision_of "$output")" = ask ]
+  mcp mcp__claude_ai_Linear__get_issue
+  [ "$(decision_of "$output")" = none ]
+  set_autopilot on
+  mcp mcp__claude_ai_Linear__save_comment
+  [ "$(decision_of "$output")" = deny ]
+}
+
+@test "G14: tracker.policy auto allows tracker writes but never chat messages" {
+  printf 'tracker.policy: auto\n' >"$R/.claude/kern.local.yml"
+  mcp mcp__claude_ai_Linear__save_issue
+  [ "$(decision_of "$output")" = allow ]
+  mcp mcp__claude_ai_Slack__send_message
+  [ "$(decision_of "$output")" = ask ]
+}
+
+@test "G14: mcp.write_servers adds a server; gh issue writes ask" {
+  printf 'mcp.write_servers: youtrack\n' >"$R/.claude/kern.local.yml"
+  mcp mcp__youtrack__update_issue
+  [ "$(decision_of "$output")" = ask ]
+  g "gh issue comment 5 --body-file c.md" g14
+  [ "$(decision_of "$output")" = ask ]
+  g "gh issue view 5" g14
+  [ "$(decision_of "$output")" = none ]
+}
+
+@test "G15: deploys and publishes ask, denied under autopilot" {
+  for c in "gh workflow run deploy.yml --ref main" "npm publish" "terraform apply -auto-approve" "kubectl rollout restart deploy/api" "helm upgrade api ./chart" "aws ecs update-service --cluster c --service s"; do
+    g "$c" g15
+    [ "$(decision_of "$output")" = ask ] || { echo "$c -> $output"; return 1; }
+  done
+  set_autopilot on
+  g "npm publish" g15
+  [ "$(decision_of "$output")" = deny ]
+}
+
+@test "G15: read-only infra commands do not vote" {
+  for c in "terraform plan" "kubectl get pods" "gh workflow list" "npm test"; do
+    g "$c" g15
+    [ "$(decision_of "$output")" = none ] || { echo "$c -> $output"; return 1; }
+  done
+}
+
+@test "G15: a push to a deploy.envs branch asks" {
+  printf 'deploy.envs: production, uat\n' >"$R/.claude/kern.local.yml"
+  g "git push origin HEAD:production" g15
+  [ "$(decision_of "$output")" = ask ]
+  g "git push origin feat" g15
+  [ "$(decision_of "$output")" = none ]
+}
+
+@test "G14: tracker.policy auto allows a gh issue or label write only in a proven shape" {
+  printf 'tracker.policy: auto\n' >"$R/.claude/kern.local.yml"
+  printf 'Body\n' >"$R/c.md"
+  for c in "gh issue comment 5 --body-file c.md" "gh issue close 5 --reason completed | tail -n 1" "gh label create bug --color ff0000 >/dev/null"; do
+    g "$c" g14
+    [ "$(decision_of "$output")" = allow ] || { echo "$c -> $output"; return 1; }
+  done
+  for c in "gh issue comment 5 --body-file c.md && rm -rf x" "rm -rf x; gh issue close 5" "gh issue create -R o/r --title x" "gh --repo=o/r issue close 5" "GH_REPO=o/r gh issue close 5" "export GH_REPO=o/r; gh issue close 5" "cd /tmp && gh issue close 5" "gh issue close 5 > out.txt" "gh issue edit 5 --title \$(id)" "gh issue comment 5 --body-file /etc/hosts" "gh issue comment https://github.com/o/r/issues/1 --body-file c.md" "gh issue create --title x --web" "gh issue transfer 5 o/r"; do
+    g "$c" g14
+    [ "$(decision_of "$output")" = ask ] || { echo "$c -> $output"; return 1; }
+  done
+  set_autopilot on
+  g "gh issue comment 5 --body-file c.md" g14
+  [ "$(decision_of "$output")" = deny ]
+}
+
+@test "G15: a push from a detached HEAD asks when deploy.envs is set, denied under autopilot" {
+  git -C "$R" switch -q --detach
+  g "git push" g15
+  [ "$(decision_of "$output")" = none ]
+  printf 'deploy.envs: production\n' >"$R/.claude/kern.local.yml"
+  for c in "git push" "git push origin" "git push origin HEAD"; do
+    g "$c" g15
+    [ "$(decision_of "$output")" = ask ] || { echo "$c -> $output"; return 1; }
+  done
+  set_autopilot on
+  g "git push" g15
+  [ "$(decision_of "$output")" = deny ]
+}
+
+@test "G15: a push of every branch or a pattern asks when deploy.envs is set, denied under autopilot" {
+  g "git push --all origin" g15
+  [ "$(decision_of "$output")" = none ]
+  printf 'deploy.envs: production\n' >"$R/.claude/kern.local.yml"
+  for c in "git push --all origin" "git push --branches origin" "git push --mirror origin" "git push origin refs/heads/*:refs/heads/*"; do
+    g "$c" g15
+    [ "$(decision_of "$output")" = ask ] || { echo "$c -> $output"; return 1; }
+  done
+  set_autopilot on
+  g "git push --all origin" g15
+  [ "$(decision_of "$output")" = deny ]
+}
