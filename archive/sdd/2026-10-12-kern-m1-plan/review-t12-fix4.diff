   done
   set_autopilot on
+  expect none g01,g05,g06 "git --version"
   expect allow g01,g05,g06 "git commit -m 'CDS-2465: x'"
   expect deny g05 "git -c alias.ci=commit commit -m 'CDS-2465: x'"
 }
@@ -915,3 +919,29 @@ key AKIAABCDEFGHIJKLMNOP"
