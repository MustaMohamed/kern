           _g13_scan "$why" "$2" $(($6 + 1))
-        elif _g13_names "${why//[\"\'\\]/}"; then
+        elif _g13_flat "$why" && _g13_names "$_G13_FLAT"; then
           vote deny G13 "a command run on another host nests too deep to check against protected targets"
         fi
         ;;
