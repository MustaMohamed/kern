diff --git a/hooks/guards/g01-git.sh b/hooks/guards/g01-git.sh
index 5bf6906..2fc9727 100644
--- a/hooks/guards/g01-git.sh
+++ b/hooks/guards/g01-git.sh
@@ -155,10 +155,13 @@ worktree write-tree "
 
 # _g01_foreign GUARD SUB: when SUB is not one of git's own commands, votes ask (deny under autopilot)
 # as GUARD and exits 0. No config is read, so -c, HOME, XDG_CONFIG_HOME, GIT_DIR, cd and include
-# paths cannot steer it. An option word (git --version, -h, --help) is no subcommand: every global
-# option that leads on to one has already been read.
+# paths cannot steer it. SUB may be an option word G1's loop does not know: only the options that
+# end git without running a subcommand pass; any other (such as --shallow-file, which takes a value
+# and hides the command after it) asks.
 _g01_foreign() {
-  case "$2" in -*) return 1 ;; esac
+  case "$2" in
+    -v | --version | -h | --help | --exec-path | --html-path | --man-path | --info-path | --list-cmds=*) return 1 ;;
+  esac
   case "$_G01_GIT_CMDS" in *" $2 "*) return 1 ;; esac
   vote ask "$1" "git $2 is not one of git's own commands (an alias or an extension); run the git command it stands for so kern can check it"
   [ "$AUTOPILOT" = 1 ] && vote deny "$1" "git $2 under autopilot: not one of git's own commands"
diff --git a/tests/hooks/g05-g06-commit.bats b/tests/hooks/g05-g06-commit.bats
index fe338a3..2462675 100644
--- a/tests/hooks/g05-g06-commit.bats
+++ b/tests/hooks/g05-g06-commit.bats
@@ -787,6 +787,9 @@ key AKIAABCDEFGHIJKLMNOP"
     expect none "$g" "git --version" || return 1
     expect none "$g" "git -h" || return 1
     expect none "$g" "git --help" || return 1
+    expect none "$g" "git --exec-path" || return 1
+    expect none "$g" "git -v" || return 1
+    expect none "$g" "git --list-cmds=builtins" || return 1
   done
   set_autopilot on
   expect none g01,g05,g06 "git --version"
@@ -945,3 +948,12 @@ key AKIAABCDEFGHIJKLMNOP"
   grep -q 'patch-text-17' "$BATS_TEST_TMPDIR/gl.in"
   grep -q 'message-text-42' "$BATS_TEST_TMPDIR/gl.in"
 }
+
+@test "git: a global option G1 does not know asks, so it cannot hide the command after it" {
+  expect ask g01 "git --foo ci"
+  [[ "$output" == *"not one of git's own commands"* ]] || false
+  set_autopilot on
+  expect deny g01,g05,g06 "git --shallow-file status push --force origin main"
+  expect deny g01 "git --foo ci"
+  expect deny g01 "git --shallow-file x commit -m 'CDS-2465: x'"
+}
