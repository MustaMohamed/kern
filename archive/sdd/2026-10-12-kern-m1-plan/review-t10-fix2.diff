+  case "$cur" in "" | *[!"$_G01_NAME_CHARS"]*) return 1 ;; esac
+  case "$remote" in *[!"$_G01_NAME_CHARS"]*) return 1 ;; esac
   while [ "$i" -lt "${#_G01_RECS[@]}" ]; do
     _g01_filter "${_G01_RECS[$i]}" || return 1
     i=$((i + 1))
@@ -396,9 +405,12 @@ _g01_proven() {
