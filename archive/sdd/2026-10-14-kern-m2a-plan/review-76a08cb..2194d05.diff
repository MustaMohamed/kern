+@test "a quoted or escaped assignment or redirect before a cd is a command name, so the cd is not plain" {
+  local pre=("'X=1'" 'X\=1' "'2>/dev/null'" '"X=1"') p cc=() sd=()
+  for p in "${pre[@]}"; do
