+    sd+=("cd $S && $p cd /tmp; echo x > foo")
+  done
+  expect_cmd ask "${cc[@]}"
+  expect_cmd deny "${sd[@]}"
+  set_autopilot on
+  expect_cmd deny "${cc[@]}" "${sd[@]}"
+  set_autopilot off
+  # Unquoted, they are an assignment and a redirect, and the cd moves.
+  expect_cmd none "cd $S && X=1 cd /tmp; echo x > foo" "cd $S && 2>/dev/null cd /tmp; echo x > foo"
+}
