@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# Human-in-the-loop reproduction loop. Copy this file, edit the steps between the markers, and run it.
+# The agent runs the script; the user follows the prompts in their terminal.
+#   step "<instruction>"        show an instruction, wait for Enter
+#   capture VAR "<question>"    show a question, read the answer into VAR
+# At the end, captured values print as KEY=VALUE for the agent to parse. Capture observations only;
+# leave signing in to the user as a step. The script exits 1 when its input closes before the last step.
+# Adapted from mattpocock/skills diagnosing-bugs/scripts/hitl-loop.template.sh (MIT).
+# shellcheck disable=SC2154  # captured variables are set through printf -v
+set -euo pipefail
+
+step() {
+  local _
+  printf '\n>>> %s\n' "$1"
+  read -r -p "    [Enter when done] " _ || { echo "hitl-loop: input closed before the step finished" >&2; exit 1; }
+}
+
+capture() {
+  local var="$1" question="$2" answer
+  printf '\n>>> %s\n' "$question"
+  read -r -p "    > " answer || { echo "hitl-loop: input closed before the question was answered" >&2; exit 1; }
+  answer=${answer%$'\r'}
+  printf -v "$var" '%s' "$answer"
+}
+
+# --- edit below ---------------------------------------------------------
+
+step "Open the app and sign in."
+
+capture ERRORED "Do the action that fails. Did it show an error? (y/n)"
+
+capture ERROR_MSG "Paste the error message (or 'none'):"
+
+# --- edit above ---------------------------------------------------------
+
+printf '\n--- Captured ---\n'
+printf 'ERRORED=%s\n' "$ERRORED"
+printf 'ERROR_MSG=%s\n' "$ERROR_MSG"
diff --git a/skills/diagnose/scripts/loop-rate.sh b/skills/diagnose/scripts/loop-rate.sh
new file mode 100755
index 0000000..067c3b6
--- /dev/null
+++ b/skills/diagnose/scripts/loop-rate.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# Run a reproduction loop N times and report how often it is red and how long one run takes, so a
+# flaky bug's rate is a number before and after the fix.
+# Usage: loop-rate.sh N -- CMD...    Prints: loop-rate: <red>/<N> red, median <seconds>s
+# A run is red when CMD exits non-zero. CMD's own output is discarded; CMD is one command with its
+# arguments, so wrap a pipeline as sh -c '...'. Exit 0. Exit 2: usage, N not a whole number from 1 to
+# 999999999, CMD not found, or the timing could not be read.
+# Adapted from pocock diagnosing-bugs (raise the reproduction rate and measure it).
+set -euo pipefail
+if [ $# -lt 3 ] || [ "$2" != "--" ]; then
+  echo "usage: loop-rate.sh N -- CMD..." >&2
+  exit 2
+fi
+n=$1
+shift 2
+case "$n" in '' | *[!0123456789]*) echo "loop-rate: N must be a whole number above 0: $n" >&2; exit 2 ;; esac
+[ "${#n}" -le 9 ] || { echo "loop-rate: N is too large: $n" >&2; exit 2; }
+n=$((10#$n))
+[ "$n" -ge 1 ] || { echo "loop-rate: N must be a whole number above 0: $n" >&2; exit 2; }
+command -v "$1" > /dev/null 2>&1 || { echo "loop-rate: command not found: $1" >&2; exit 2; }
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/kern-loop.XXXXXX") || { echo "loop-rate: cannot create a temp directory" >&2; exit 2; }
+trap 'rm -rf "$tmp"' EXIT
+# bash's own timer prints the real seconds on the group's stderr; a C locale keeps the decimal point a dot.
+export LC_ALL=C
+TIMEFORMAT=%R
+: > "$tmp/secs"
+red=0
+i=0
+while [ "$i" -lt "$n" ]; do
+  i=$((i + 1))
+  if ! { time "$@" > /dev/null 2>&1; } 2> "$tmp/time"; then red=$((red + 1)); fi
+  tr -d '\r' < "$tmp/time" | grep -E '^[0123456789]+[.][0123456789]+$' >> "$tmp/secs" || {
+    echo "loop-rate: could not read the run time of run $i" >&2
+    exit 2
+  }
+done
+median=$(sort -n "$tmp/secs" | awk '{ v[NR] = $1 } END { if (NR % 2) printf "%.3f\n", v[(NR + 1) / 2]; else printf "%.3f\n", (v[NR / 2] + v[NR / 2 + 1]) / 2 }')
+echo "loop-rate: $red/$n red, median ${median}s"
