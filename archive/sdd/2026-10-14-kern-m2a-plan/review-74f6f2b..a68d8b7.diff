 @test "without gh the buckets come from local state and say so" {
   rm "$TMP/bin/gh"
   bash "$KERN_ROOT/scripts/wt-new" local-one > /dev/null 2>&1
-  PATH="$TMP/bin:/usr/bin:/bin" run --separate-stderr bash "$KERN_ROOT/scripts/wt-audit"
