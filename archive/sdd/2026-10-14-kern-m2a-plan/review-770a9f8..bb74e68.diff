+  : >"$BATS_TEST_TMPDIR/empty.sh"
+  for s in "$BATS_TEST_TMPDIR/none.sh" "$BATS_TEST_TMPDIR/empty.sh" "$BATS_TEST_TMPDIR/garbage.sh" "$SNAPS"; do
