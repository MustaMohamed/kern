   [ "$status" -eq 0 ]
   [ "${lines[0]}" = 'Decision: one; why: x; cost if wrong: y' ]
   [ "${lines[1]}" = 'Task 1: minor (deferred): rename a helper' ]
   [ "${lines[2]}" = 'parked: q; default: d; why: w' ]
   [ "${lines[3]}" = 'main: unchanged' ]
   printf 'x\n' > "$REPO/stray.txt"
