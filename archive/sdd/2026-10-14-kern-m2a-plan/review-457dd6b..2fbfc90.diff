+  mkdir -p "$P/$sslug-projB" "$P/$sslug-other"
+  printf 'p\n' > "$P/$sslug-projB/projb.jsonl"
+  printf 'p\n' > "$P/$sslug-other/otherp.jsonl"
+  hist_line projb "$shared/projB" "floci in projB"
