#!/usr/bin/env bash
# Extract one task, plus the plan's Global Constraints, into LEDGER_DIR/briefs/task-N.md.
# Usage: task-brief PLAN N LEDGER_DIR    Prints the brief path. Exit 2 when the task is not found.
# Adapted from superpowers subagent-driven-development/scripts/task-brief (MIT).
set -euo pipefail
[ $# -eq 3 ] || { echo "usage: task-brief PLAN N LEDGER_DIR" >&2; exit 2; }
plan=$1 n=$2 ledger_dir=$3
[ -f "$plan" ] || { echo "task-brief: no such plan: $plan" >&2; exit 2; }
case "$n" in ''|*[!0-9]*) echo "task-brief: N must be a number: $n" >&2; exit 2 ;; esac

# Code fences as plan-check reads them (its fence_run rule): an opener is a run of 3 or more backticks or
# tildes after at most 3 spaces, and the info string of a backtick opener holds no backtick; only a run of
# the same character, at least as long, with nothing but spaces after it, closes the fence. So a tilde
# fence may hold a backtick line, and a longer fence may hold a shorter one. fmark is 1 on an opening line
# and -1 on a closing one; a line's CR is ignored here and kept in the brief. Its globals (fmark, fence,
# fch, flen, fc, run, rest, l) must not clash with a program's own: the task program's n is the task.
# shellcheck disable=SC2016 # awk text
FENCE='
function fence_run(s, c,   n) {
  sub(/^ ? ? ?/, "", s)
  n = 0
  while (substr(s, n + 1, 1) == c) n++
  return n
}
{
  fmark = 0
  l = $0; sub(/\r$/, "", l)
  if (fence) {
    run = fence_run(l, fch)
    if (run >= flen) { rest = l; sub(/^ ? ? ?/, "", rest); if (substr(rest, run + 1) ~ /^[ \t]*$/) fmark = -1 }
  } else {
    fc = "`"; run = fence_run(l, fc)
    if (run < 3) { fc = "~"; run = fence_run(l, fc) }
    if (run >= 3) { rest = l; sub(/^ ? ? ?/, "", rest); if (fc == "~" || index(substr(rest, run + 1), "`") == 0) fmark = 1 }
  }
  if (fmark == 1) { fence = 1; fch = fc; flen = run } else if (fmark == -1) fence = 0
}
'

task=$(awk -v n="$n" "$FENCE"'
  fmark || fence { if (intask) print; next }
  /^#+[ \t]/ {
    match($0, /^#+/); lvl = RLENGTH
    if ($0 ~ /^#+[ \t]+Task[ \t]+[0-9]+/) {
      intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")); tlvl = lvl
    } else if (intask && lvl <= tlvl) {
      intask = 0
    }
  }
  intask { print }
' "$plan")
[ -n "$task" ] || { echo "task-brief: no heading 'Task $n' in $plan" >&2; exit 2; }

constraints=$(awk "$FENCE"'
  !fmark && !fence && /^## / { gc = ($0 ~ /^## Global Constraints/) }
  gc { print }
' "$plan")

mkdir -p "$ledger_dir/briefs"
out="$ledger_dir/briefs/task-$n.md"
plan_abs=$(cd "$(dirname "$plan")" && pwd -P)/$(basename "$plan")
{
  printf '# Brief: Task %s\n\nPlan: %s\n\n' "$n" "$plan_abs"
  if [ -n "$constraints" ]; then printf '%s\n\n' "$constraints"; fi
  printf '%s\n' "$task"
} > "$out"
printf '%s\n' "$out"
