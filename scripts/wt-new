#!/usr/bin/env bash
# Create a kern worktree off a freshly fetched origin/<base>, copy .worktreeinclude files, run worktree.setup.
# Usage: wt-new SLUG [--detach] [--base REF | --plan PLAN [--base SHA]] [--branch NAME]
# A SHA-shaped REF is used as a commit with no fetch (bisection); any other base must fetch from origin.
# Exit 2 when the local branch of that name holds commits origin lacks: the worktree would leave them out.
# --base SHA beside --plan builds on that commit instead, such as the local branch's tip.
# --plan reads the base from PLAN's frontmatter `base:` line, which names its source after the branch, as
# `base: main (settings); promotion: none`: the branch is the text before the first " (" or ";". A base of
# `unknown`, or none, falls back as with no --base.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd -P)
# shellcheck source=/dev/null
. "$here/../hooks/lib/settings.sh"
# shellcheck source=/dev/null
. "$here/lib/wt-common.sh"

usage() { echo "usage: wt-new SLUG [--detach] [--base REF | --plan PLAN [--base SHA]] [--branch NAME]" >&2; exit 2; }
is_sha() { printf '%s' "$1" | grep -Eq '^[0-9a-f]{7,64}$'; }

# plan_base PLAN: the branch PLAN's frontmatter `base:` line names, without its source; empty for none.
plan_base() {
  awk '{ sub(/\r$/, "") }
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    /^base:/ { v = substr($0, 6); sub(/;.*/, "", v); sub(/ \(.*/, "", v); gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit }' "$1"
}
[ $# -ge 1 ] || usage
slug=$1
shift
# The letters are listed: a range such as A-Z follows the locale's collation in bash 3.2, and in
# en_US.UTF-8 takes letters such as e-acute too.
case "$slug" in ''|.*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*) echo "wt-new: bad slug: $slug" >&2; exit 2 ;; esac
detach=0 base='' branch='' plan='' based=0
while [ $# -gt 0 ]; do
  case "$1" in
    --detach) detach=1; shift ;;
    --base) [ $# -ge 2 ] || usage; base=$2; based=1; shift 2 ;;
    --plan) [ $# -ge 2 ] || usage; plan=$2; shift 2 ;;
    --branch) [ $# -ge 2 ] || usage; branch=$2; shift 2 ;;
    *) usage ;;
  esac
done
if [ -n "$plan" ]; then
  [ "$based" = 0 ] || is_sha "$base" || { echo "wt-new: with --plan, --base takes a commit SHA, not $base" >&2; usage; }
  [ -f "$plan" ] || { echo "wt-new: no plan at $plan" >&2; exit 2; }
  if [ "$based" = 0 ]; then
    base=$(plan_base "$plan") || { echo "wt-new: could not read the base line of $plan" >&2; exit 2; }
    [ "$base" != unknown ] || base=''
  fi
fi

MAIN=$(kern_main_root "$PWD") || { echo "wt-new: not a git repository" >&2; exit 2; }
# settings_get reads KERN_MAIN, so worktree.dir and worktree.setup come from MAIN, not the caller's cwd.
export KERN_MAIN="$MAIN"
if [ -z "$base" ]; then
  rc=0
  base=$(settings_get base_branch) || rc=$?
  case "$rc" in
    0) ;;
    4) echo "wt-new: base_branch is unknown: $(settings_unread_why base_branch); pass --base" >&2; exit 2 ;;
    *)
      base=$(bash "$here/kern-detect" base_branch | cut -f1) ||
        { echo "wt-new: base_branch is not set and not detectable; set it in .claude/kern.local.yml" >&2; exit 2; }
      ;;
  esac
fi

if is_sha "$base"; then
  git -C "$MAIN" rev-parse --verify --quiet "$base^{commit}" > /dev/null ||
    { echo "wt-new: unknown commit $base" >&2; exit 2; }
  start=$base
else
  name=${base#origin/}
  start="refs/remotes/origin/$name"
  # The refspec names the tracking ref, which a single-branch clone's fetch config does not cover.
  if ! err=$(git -C "$MAIN" fetch --quiet origin "+refs/heads/$name:$start" 2>&1 > /dev/null); then
    # git's first line gives the reason (no such repository, auth, no such branch); its last is advice.
    why=$(printf '%s\n' "$err" | awk '{ sub(/\r$/, "") } NF && !/^(hint|warning):/ { print; exit }')
    echo "wt-new: git fetch origin $name failed${why:+ ($why)}; kern branches only off a fresh origin/$name" >&2
    exit 2
  fi
  git -C "$MAIN" rev-parse --verify --quiet "$start" > /dev/null ||
    { echo "wt-new: $start is missing after the fetch" >&2; exit 2; }
  if git -C "$MAIN" rev-parse --verify --quiet "refs/heads/$name" > /dev/null; then
    ahead=$(git -C "$MAIN" rev-list --count "$start..refs/heads/$name") ||
      { echo "wt-new: could not compare local $name with origin/$name" >&2; exit 2; }
    if [ "$ahead" -gt 0 ]; then
      echo "wt-new: local $name is $ahead commits ahead of origin/$name; push, or pass --base <sha>" >&2
      exit 2
    fi
  fi
fi

dir=$(wt_dir) || { echo "wt-new: no worktree made while worktree.dir is unknown" >&2; exit 2; }
path="$dir/$slug"
wt_path_free "$path" || exit 2
mkdir -p "$dir"
wt_exclude_dir "$dir"

if [ "$detach" = 1 ]; then
  git -C "$MAIN" worktree add --quiet --detach "$path" "$start" >&2
else
  if [ -z "$branch" ]; then
    rc=0
    pattern=$(settings_get branch.pattern 'kern/{slug}') || rc=$?
    [ "$rc" = 0 ] || { echo "wt-new: branch.pattern is unknown: $(settings_unread_why branch.pattern); pass --branch NAME" >&2; exit 2; }
    branch=${pattern//\{slug\}/$slug}
    case "$branch" in
      *'{'*) echo "wt-new: branch.pattern has placeholders wt-new cannot fill ($branch); pass --branch NAME" >&2; exit 2 ;;
    esac
  fi
  git -C "$MAIN" check-ref-format --branch "$branch" > /dev/null 2>&1 ||
    { echo "wt-new: bad branch name: $branch" >&2; exit 2; }
  if git -C "$MAIN" rev-parse --verify --quiet "refs/heads/$branch" > /dev/null; then
    echo "wt-new: branch exists: $branch" >&2
    exit 2
  fi
  git -C "$MAIN" worktree add --quiet --no-track -b "$branch" "$path" "$start" >&2
fi

path=$(cd "$path" && pwd -P)
wt_include "$path"
wt_setup "$path" || exit 2
printf '%s\n' "$path"
