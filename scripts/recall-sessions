#!/usr/bin/env bash
# List this project's Claude Code sessions for recall: the main worktree's transcripts and its kern
# worktrees', newest first, inside a window; with --topic, also this project's prompts that name the
# topic. Never reads another project's transcripts or prompts. Read-only.
# Usage: recall-sessions [--days N] [--topic TEXT]
# Output: session<TAB><iso mtime><TAB><session id><TAB><bytes><TAB><path>, newest first; the newest is
# usually the session running now. Then, with --topic: prompt<TAB><iso time><TAB><session id><TAB><text>
# in history order; a prompt with no sessionId shows `-` there.
# Exit: 0; 2 on a usage error or outside a git repository; 1 when a folder, a file or a command it
# needs fails (nothing is printed then, so a failure never reads as "no sessions").
# A MISSING ~/.claude/projects, transcript folder or history.jsonl is not an error: no records is the
# truth there, and the answer is empty. One that exists but cannot be read (or a dangling symlink) is
# an error.
# Scope. A worktree is this project's when `git worktree list` names it: its transcripts are the
# folder whose slug equals that path's slug, its prompts those whose project equals the path. When
# worktree.dir (resolved to a physical path) exists and lies inside the main checkout, its slug
# prefix and path prefix are also taken, which finds sessions of kern worktrees since removed. A
# worktree.dir outside the main checkout may be shared with other projects, so it adds no prefix:
# sessions of removed worktrees there are not found (accepted). A session started in a subdirectory
# of the main checkout is not listed either (accepted): a prefix match would take sibling projects
# (/x/kern-old).
# Shared slug (accepted): Claude Code turns every character outside A-Za-z0-9 into -, so a dot,
# underscore, space or dash alike; two paths differing only in those share one transcript folder, and
# this lists both paths' sessions. Prompts are matched by exact path and are not affected.
# history.jsonl is read with awk, not a JSON parser: "display" is unescaped for \" \\ \/ and \n \t \r
# (the last three become a space); \uXXXX is left as typed, so a topic never matches across one. Keys
# are matched as written compactly ("project":"..."). Text and the 120-character cut are bytes
# (LC_ALL=C), and the topic matches case-insensitively for ASCII only.
# Adapted from the user's recall skill, "Where the records are" (MIT, local copy).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd -P)
# shellcheck source=/dev/null
. "$here/../hooks/lib/settings.sh"
# shellcheck source=/dev/null
. "$here/lib/wt-common.sh"
usage() { echo "usage: recall-sessions [--days N] [--topic TEXT]" >&2; exit 2; }
die() { echo "recall-sessions: $*" >&2; exit 1; }
days=7 topic=''
while [ $# -gt 0 ]; do
  case "$1" in
    --days) [ $# -ge 2 ] || usage; days=$2; shift 2 ;;
    --topic) [ $# -ge 2 ] && [ -n "$2" ] || usage; topic=$2; shift 2 ;;
    *) usage ;;
  esac
done
case "$days" in '' | *[!0-9]*) usage ;; esac
# Drop leading zeros so 08 is not read as octal in arithmetic or by find.
while [ "${#days}" -gt 1 ] && [ "${days#0}" != "$days" ]; do days=${days#0}; done
[ "${#days}" -le 6 ] || usage
MAIN=$(kern_main_root "$PWD") || { echo "recall-sessions: not a git repository" >&2; exit 2; }
export KERN_MAIN="$MAIN"
projects="$HOME/.claude/projects"
hist="$HOME/.claude/history.jsonl"
# Claude Code names a project's transcript folder after its path, every character outside A-Z, a-z and
# 0-9 turned into -.
slug() { printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9' '-'; }

# need_dir PATH: a path that exists (or is a symlink, even a dangling one) must be readable.
# Missing is fine: [ -d ] and [ -e ] cannot tell an unreadable path from a missing one.
need_dir() {
  if [ -e "$1" ] || [ -L "$1" ]; then
    { [ -d "$1" ] && [ -r "$1" ] && [ -x "$1" ]; } || die "cannot read $1"
  fi
}
[ -r "$HOME" ] && [ -x "$HOME" ] || die "cannot read $HOME"
need_dir "$HOME/.claude"
need_dir "$projects"

# iso_at SECONDS: local time of an epoch second. GNU date takes -d @S and rejects -r S; BSD date takes
# -r S and rejects -d @S. Pick once, so a real failure is not mistaken for the other system's syntax.
if date -d @0 +%s > /dev/null 2>&1; then
  iso_at() { date -d "@$1" +%Y-%m-%dT%H:%M; }
else
  iso_at() { date -r "$1" +%Y-%m-%dT%H:%M; }
fi

# This project's worktrees: the main one and every linked one, exactly as git lists them.
wts=$(git -C "$MAIN" worktree list --porcelain | sed -n 's/^worktree //p') || die "git worktree list failed"
[ -n "$wts" ] || die "git worktree list named no worktree"
# The worktree dir is a prefix only when it exists inside the main checkout.
wt_root=$(wt_dir) || die "cannot resolve the worktree dir"
WTP=''
if [ -d "$wt_root" ]; then
  wt_phys=$(CDPATH='' cd -- "$wt_root" && pwd -P) || die "cannot resolve $wt_root"
  main_phys=$(CDPATH='' cd -- "$MAIN" && pwd -P) || die "cannot resolve $MAIN"
  case "$wt_phys" in "$main_phys"/*) WTP="$wt_phys/" ;; esac
fi

folders=''
while IFS= read -r w; do
  s=$(slug "$w") || die "cannot slug $w"
  folders="$folders$projects/$s"$'\n'
done <<EOT
$wts
EOT
if [ -n "$WTP" ]; then
  s=$(slug "$WTP") || die "cannot slug $WTP"
  # An unmatched glob stays literal and fails the -d test below.
  for d in "$projects/$s"*; do folders="$folders$d"$'\n'; done
fi

TAB=$'\t'
recs='' nrec=0 seen=$'\n'
while IFS= read -r d; do
  [ -d "$d" ] || continue
  case "$seen" in *$'\n'"$d"$'\n'*) continue ;; esac
  seen="$seen$d"$'\n'
  # Top-level transcripts only: subagents/, tool-results/ and workflows/ hold a session's children.
  found=$(find "$d" -maxdepth 1 -type f -name '*.jsonl' -mtime "-$days") || die "cannot read $d"
  [ -n "$found" ] || continue
  while IFS= read -r f; do
    # `date -r FILE` is the file's mtime on both BSD and GNU date.
    epoch=$(date -r "$f" +%s) || die "cannot read the mtime of $f"
    iso=$(date -r "$f" +%Y-%m-%dT%H:%M) || die "cannot read the mtime of $f"
    bytes=$(wc -c < "$f") || die "cannot read $f"
    bytes=${bytes//[[:space:]]/}
    case "$epoch" in '' | *[!0-9]*) die "unreadable mtime for $f" ;; esac
    case "$bytes" in '' | *[!0-9]*) die "unreadable size for $f" ;; esac
    [ -n "$iso" ] || die "empty mtime for $f"
    id=${f##*/}
    recs="$recs$epoch$TAB$iso$TAB${id%.jsonl}$TAB$bytes$TAB$f"$'\n'
    nrec=$((nrec + 1))
  done <<EOT
$found
EOT
done <<EOT
$folders
EOT

out='' nout=0
if [ -n "$recs" ]; then
  sorted=$(printf '%s' "$recs" | LC_ALL=C sort -t "$TAB" -k1,1nr -k3,3) || die "sort failed"
  [ -n "$sorted" ] || die "sort returned 0 of $nrec sessions"
  while IFS="$TAB" read -r _ iso id bytes f; do
    out="${out}session$TAB$iso$TAB$id$TAB$bytes$TAB$f"$'\n'
    nout=$((nout + 1))
  done <<EOT
$sorted
EOT
  [ "$nout" -eq "$nrec" ] || die "sort returned $nout of $nrec sessions"
fi

if [ -n "$topic" ] && { [ -e "$hist" ] || [ -L "$hist" ]; }; then
  [ -f "$hist" ] && [ -r "$hist" ] || die "cannot read $hist"
  now=$(date +%s) || die "date failed"
  case "$now" in '' | *[!0-9]*) die "date gave no epoch" ;; esac
  since=$(( (now - days * 86400) * 1000 ))
  prompts=$(MAIN=$MAIN WTS=$wts WTP=$WTP TOPIC=$topic SINCE=$since LC_ALL=C awk '
    # The value of string key k, up to its first unescaped quote. A quote inside a string is always
    # written \", so "k":" never matches inside a value.
    function field(k,   pat, i, rest, j, o, e) {
      pat = "\"" k "\":\""
      i = index($0, pat)
      if (i == 0) return ""
      rest = substr($0, i + length(pat)); o = ""
      while ((j = match(rest, /["\\]/)) > 0) {
        o = o substr(rest, 1, j - 1)
        if (substr(rest, j, 1) == "\"") return o
        e = substr(rest, j + 1, 1)
        if (e == "n" || e == "t" || e == "r") o = o " "
        else if (e == "\"" || e == "\\" || e == "/") o = o e
        else o = o "\\" e
        rest = substr(rest, j + 2)
      }
      return o
    }
    BEGIN { nw = split(ENVIRON["WTS"], W, "\n") }
    {
      p = field("project"); ok = 0
      for (i = 1; i <= nw; i++) if (p == W[i]) ok = 1
      if (!ok && ENVIRON["WTP"] != "" && index(p, ENVIRON["WTP"]) == 1) ok = 1
      if (!ok) next
      if (!match($0, /"timestamp":[0-9]+/)) next
      ts = substr($0, RSTART + 12, RLENGTH - 12) + 0
      if (ts < ENVIRON["SINCE"] + 0) next
      d = field("display")
      if (index(tolower(d), tolower(ENVIRON["TOPIC"])) == 0) next
      sid = field("sessionId"); if (sid == "") sid = "-"
      printf "%.0f\t%s\t%s\n", ts / 1000, sid, substr(d, 1, 120)
    }' "$hist") || die "cannot read $hist (awk failed)"
  if [ -n "$prompts" ]; then
    while IFS="$TAB" read -r ts sid text; do
      iso=$(iso_at "$ts") || die "cannot format the time of a prompt ($ts)"
      [ -n "$iso" ] || die "empty time for a prompt ($ts)"
      out="${out}prompt$TAB$iso$TAB$sid$TAB$text"$'\n'
    done <<EOT
$prompts
EOT
  fi
fi
printf '%s' "$out"
