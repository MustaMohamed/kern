#!/usr/bin/env bash
# G10, fail-then-pass. Patch mode: CMD passes in WT; on a throwaway fork with PATCH reversed, CMD fails.
# Mutate mode: CMD passes in WT; on a fork with one condition inverted at FILE:LINE, CMD fails.
# Usage: probe [--with-passed] [--exclude-tests] WT PATCH -- CMD...
#        probe [--with-passed] --mutate FILE:LINE WT -- CMD...
# --with-passed skips the run in WT, for a caller that has just run CMD on this same tree (task-done). The
# fork's runs stay. The fork shares WT's setup (wt-fork --share-setup). A control run that fails there, or a
# run that passes with the change in, gets one more fork with worktree.setup run, and that fork gives the
# verdict.
# --exclude-tests reverses only the non-test files of PATCH, so a test the patch adds stays in the fork,
# with its test data, fixtures, snapshots and golden files (is_probe_keep); without it, a PATCH that
# touches one is inconclusive. A command word that names a path in WT must still exist in the fork, and a
# command word, or a file one names, that holds WT's absolute path is inconclusive. FILE is relative to
# WT, with no .. part, and must not resolve through a symlink outside the fork. Exit 0 ok, with the last
# lines of the reversed run on stderr; 1 the test did not fail; 3 inconclusive; 2 usage.
# The fork is always removed.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd -P)
usage() { echo "usage: probe [--with-passed] [--exclude-tests] WT PATCH -- CMD... | probe [--with-passed] --mutate FILE:LINE WT -- CMD..." >&2; exit 2; }
excl=0 mutate='' patch='' passed=0
if [ "${1-}" = --with-passed ]; then passed=1; shift; fi
case "${1-}" in
  --exclude-tests) excl=1; shift ;;
  --mutate) [ $# -ge 2 ] || usage; mutate=$2; shift 2 ;;
esac
if [ -n "$mutate" ]; then
  [ $# -ge 3 ] && [ "$2" = -- ] || usage
  wtarg=$1
  shift 2
  mfile=${mutate%:*} mline=${mutate##*:}
  case "$mline" in '' | *[!0-9]*) usage ;; esac
  case "$mfile" in /* | .. | ../* | */.. | */../*) echo "probe: --mutate takes a path relative to WT, with no .. part: $mfile" >&2; exit 2 ;; esac
else
  [ $# -ge 4 ] && [ "$3" = -- ] || usage
  wtarg=$1
  [ -s "$2" ] || { echo "probe: inconclusive (empty or missing patch: $2)"; exit 3; }
  patch=$(cd "$(dirname "$2")" && pwd -P)/$(basename "$2")
  shift 3
fi
wt=$(cd "$wtarg" 2> /dev/null && pwd -P) || { echo "probe: no such worktree: $wtarg" >&2; exit 2; }

logs=$(mktemp -d "${TMPDIR:-/tmp}/kern-probe.XXXXXX")
fork=''
cleanup() {
  if [ -n "$fork" ] && [ -d "$fork" ]; then git -C "$wt" worktree remove --force "$fork" > /dev/null 2>&1 || true; fi
  rm -rf "$logs"
}
trap cleanup EXIT

excludes=()
if [ -n "$mutate" ]; then
  if [ -L "$wt/$mfile" ] && [ ! -f "$wt/$mfile" ]; then
    echo "probe: inconclusive ($mfile is a symlink that does not resolve to a file: a loop, a dangling link or a directory)"
    exit 3
  fi
  [ -f "$wt/$mfile" ] || { echo "probe: inconclusive (no such file in the worktree: $mfile)"; exit 3; }
else
  # Every path the patch touches (both sides of a rename), then the test paths and test data among them.
  git -C "$wt" apply --numstat -z "$patch" > "$logs/numstat" 2> /dev/null || { echo "probe: inconclusive (cannot read the patch)"; exit 3; }
  tr '\0' '\n' < "$logs/numstat" |
    awk 'n > 0 { print; n--; next } /^[0-9-]+\t[0-9-]+\t$/ { n = 2; next } { sub(/^[0-9-]+\t[0-9-]+\t/, ""); if ($0 != "") print }' > "$logs/paths"
  awk -v print_keep=1 -f "$here/lib/test-paths.awk" "$logs/paths" > "$logs/tests"
  if [ -s "$logs/tests" ]; then
    if [ "$excl" = 0 ]; then
      echo "probe: inconclusive (the patch changes test files: $(paste -sd ' ' - < "$logs/tests"); pass --exclude-tests so they stay in the fork)"
      exit 3
    fi
    if [ -z "$(awk 'NR == FNR { t[$0] = 1; next } !($0 in t)' "$logs/tests" "$logs/paths")" ]; then
      echo "probe: inconclusive (the patch changes only test files; there is no change to reverse)"
      exit 3
    fi
    while IFS= read -r p; do
      excludes+=("--exclude=$(printf '%s' "$p" | sed 's/[][*?\\]/\\&/g')")
    done < "$logs/tests"
  fi
fi

# A command that names WT by its absolute path, as a word or inside a script it names, runs WT, not the fork.
# names_wt [FILE]: a line of FILE (or stdin) holds WT, physical or as given, followed by a character
# outside [A-Za-z0-9._-] or the line's end; a sibling path such as WT-b or WT.bak does not count.
# FILE's #! first line is skipped: an in-tree venv's script names its own tree, so the fork's names the fork.
wtl=$(cd "$wtarg" && pwd)
names_wt() {
  local file=0
  [ $# -eq 0 ] || file=1
  # shellcheck disable=SC2016 # $0 is awk's, not the shell's
  env P1="$wt" P2="$wtl" LC_ALL=C awk -v file="$file" '
    function at(s, p,   i, c) {
      while ((i = index(s, p)) > 0) {
        c = substr(s, i + length(p), 1)
        if (c !~ /^[A-Za-z0-9._-]$/) return 1
        s = substr(s, i + 1)
      }
      return 0
    }
    file && FNR == 1 && /^#!/ { next }
    at($0, ENVIRON["P1"]) || at($0, ENVIRON["P2"]) { found = 1; exit }
    END { exit !found }' "$@"
}
for a in "$@"; do
  if names_wt <<< "$a"; then
    echo "probe: inconclusive (the command names the worktree by its absolute path, so the fork would run the worktree)"
    exit 3
  fi
  case "$a" in /*) f=$a ;; *) f=$wt/$a ;; esac
  if [ -f "$f" ] && [ -r "$f" ] && names_wt "$f"; then
    echo "probe: inconclusive ($a names the worktree by its absolute path, so the fork would run the worktree)"
    exit 3
  fi
done

if [ "$passed" = 0 ] && ! (cd "$wt" && "$@") > "$logs/with.log" 2>&1; then
  echo "probe: inconclusive (the command fails with the guard in place)"
  tail -n 5 "$logs/with.log"
  exit 3
fi

slug="probe-$$-$RANDOM"
# make_fork [--share-setup]: fork stays as it was on a failure, so cleanup still removes an earlier fork.
make_fork() {
  local made
  if ! made=$(cd "$wt" && bash "$here/wt-fork" "$wt" "$slug" "$@" 2> "$logs/fork.err"); then
    echo "probe: inconclusive (could not fork: $(tail -n 1 "$logs/fork.err"))"
    exit 3
  fi
  fork=$made
}
# refork: swap the shared fork for one with worktree.setup run. Clearing shared bounds this to one retry.
refork() {
  git -C "$wt" worktree remove --force "$fork" > /dev/null 2>&1 || true
  make_fork
  shared=0
}

# attempt CMD...: on the fork, CMD passes, the change goes in, and CMD runs again; survived=1 when that run
# passes too. A control run that fails on a shared fork starts over on a fork with setup.
attempt() {
  if ! (cd "$fork" && "$@") > "$logs/control.log" 2>&1; then
    if [ "$shared" = 1 ]; then
      refork
      attempt "$@"
      return
    fi
    echo "probe: inconclusive (the command fails in the fork before any change is reversed; missing ignored files or setup?)"
    tail -n 5 "$logs/control.log" >&2
    exit 3
  fi

  if [ -n "$mutate" ]; then
    # The write below follows symlinks, so FILE and each link it leads through must end inside the fork.
    # The 20-link limit sits below the kernels' own (32 on macOS, 40 on Linux), so a test can reach it.
    mpath=$fork/$mfile hops=0
    while [ -L "$mpath" ] && [ "$hops" -lt 20 ]; do
      link=$(readlink "$mpath")
      hops=$((hops + 1))
      case "$link" in /*) mpath=$link ;; *) mpath=${mpath%/*}/$link ;; esac
    done
    if [ -L "$mpath" ]; then
      echo "probe: inconclusive ($mfile: symlink chain does not end within 20 links)"
      exit 3
    fi
    mdir=$(cd -P "${mpath%/*}" 2> /dev/null && pwd -P) || mdir=''
    case "$mdir/" in "$fork"/*) inside=1 ;; *) inside=0 ;; esac
    if [ "$inside" = 0 ]; then
      echo "probe: inconclusive ($mfile resolves through a symlink outside the fork)"
      exit 3
    fi
    # Invert the first operator found on the line, in this order; a word must stand alone. With none, drop
    # the first negation: a ! not before = and not after a name character or a closing bracket, so
    # if (!ok) becomes if (ok) while x!.y and != stay. A ! beside another ! is never dropped, so a!!.b,
    # xs !! 0 and !!x are inconclusive, not a broken build read as caught. A lone ! after punctuation
    # inside a string, a regex or a shebang can still be dropped. With no ! on the line, a bare condition is
    # wrapped in !( ): the whole of if (COND), else the name, call or index before a ? with a blank on each
    # side, so a?.b and a ?? b stay. A loop stays out: its inverse can run for ever.
    if ! awk -v ln="$mline" '
      function word(s, w,   i, b, a) {
        i = index(s, w); if (!i) return 0
        b = (i == 1) ? "" : substr(s, i - 1, 1); a = substr(s, i + length(w), 1)
        return (b !~ /[A-Za-z0-9_]/ && a !~ /[A-Za-z0-9_]/) ? i : 0
      }
      # negate(s, from, upto): s with the text between the two positions wrapped in !( ).
      function negate(s, from, upto) { return substr(s, 1, from - 1) "!(" substr(s, from, upto - from + 1) ")" substr(s, upto + 1) }
      # closer(s, open): the position of the ) that closes the ( at open, or 0.
      function closer(s, open,   i, c, d) {
        for (i = open; i <= length(s); i++) {
          c = substr(s, i, 1)
          if (c == "(") d++
          else if (c == ")" && --d == 0) return i
        }
        return 0
      }
      # operand(s, upto): where the name, call or index that ends at upto starts; upto + 1 for none.
      function operand(s, upto,   i, c, d) {
        for (i = upto; i >= 1; i--) {
          c = substr(s, i, 1)
          if (c == ")" || c == "]") d++
          else if (d > 0 && (c == "(" || c == "[")) d--
          else if (d == 0 && c !~ /[A-Za-z0-9_$.]/) break
        }
        return (d > 0) ? upto + 1 : i + 1
      }
      NR == ln {
        n = split("===,!==,==,!=,<=,>=,&&,||, < , > ,true,false", op, ",")
        split("!==,===,!=,==,>,<,||,&&, >= , <= ,false,true", to, ",")
        for (k = 1; k <= n; k++) {
          i = (op[k] ~ /^[a-z]+$/) ? word($0, op[k]) : index($0, op[k])
          if (i) { $0 = substr($0, 1, i - 1) to[k] substr($0, i + length(op[k])); done = 1; print > "/dev/stderr"; break }
        }
        for (i = 1; !done && i <= length($0); i++) {
          if (substr($0, i, 1) != "!") continue
          a = substr($0, i + 1, 1); b = (i == 1) ? "" : substr($0, i - 1, 1)
          # a == "=" is defensive: the operator loop already took a line with !=.
          if (a == "=" || a == "" || a == "!" || b ~ /[]A-Za-z0-9_)}!]/) continue
          $0 = substr($0, 1, i - 1) substr($0, i + 1); done = 1; print > "/dev/stderr"
        }
        if (!done && !index($0, "!")) {
          i = word($0, "if")
          if (i) {
            for (i += 2; substr($0, i, 1) == " "; i++) continue
            if (substr($0, i, 1) == "(" && (a = closer($0, i)) > i + 1) { $0 = negate($0, i + 1, a - 1); done = 1 }
          }
          if (!done && (a = index($0, " ? ")) > 1 && (i = operand($0, a - 1)) < a) { $0 = negate($0, i, a - 1); done = 1 }
          if (done) print > "/dev/stderr"
        }
      }
      { print }
      END { exit done ? 0 : 1 }' "$fork/$mfile" > "$logs/mutated" 2> "$logs/mutated-line"; then
      echo "probe: inconclusive (no condition to invert on $mfile:$mline)"
      exit 3
    fi
    cat "$logs/mutated" > "$fork/$mfile"
  else
    # --whitespace=nowarn: the user's apply.whitespace must not change or refuse the reversed tree.
    if ! git -C "$fork" apply -R --whitespace=nowarn --check ${excludes[@]+"${excludes[@]}"} "$patch" 2> "$logs/apply.err"; then
      echo "probe: inconclusive (the patch does not reverse-apply: $(head -n 1 "$logs/apply.err"))"
      exit 3
    fi
    git -C "$fork" apply -R --whitespace=nowarn ${excludes[@]+"${excludes[@]}"} "$patch"
    for a in "$@"; do
      case "$a" in -* | */) continue ;; esac
      if [ -e "$wt/$a" ] && [ ! -e "$fork/$a" ]; then
        echo "probe: inconclusive (the command names $a, which the reversed fork lacks)"
        exit 3
      fi
    done
  fi

  survived=0
  if (cd "$fork" && "$@") > "$logs/without.log" 2>&1; then survived=1; fi
}

make_fork --share-setup
shared=0
if [ "$(cat "$(git -C "$fork" rev-parse --path-format=absolute --git-dir)/kern-setup-done")" = 'setup: shared' ]; then shared=1; fi
attempt "$@"
# A verdict must not rest on links into WT: through one, as an npm workspace or an editable install leaves,
# the changed fork runs WT's unchanged code, so a run that passes on a shared fork proves nothing yet.
if [ "$survived" = 1 ] && [ "$shared" = 1 ]; then
  refork
  attempt "$@"
fi
if [ "$survived" = 1 ]; then
  if [ -n "$mutate" ]; then echo "probe: mutation survived ($(cat "$logs/mutated-line"))"; else echo "probe: test did not fail with the guard removed"; fi
  exit 1
fi
# Words that mean the test did not run, in any case. A missing name is the error a reversed patch gives
# when it adds a function or export the test calls; a plain TypeError can be a real assertion, so it stays out.
# The shell's ': not found' is matched in its own case, so an HTTP 'Not Found' stays an assertion.
# A None or nil receiver is what a reversed None or nil guard gives, a real failure, so its lines drop out;
# "'Gate' object has no attribute 'check'" is a missing name and stays.
blocked='error TS[0-9]+|SyntaxError|Cannot find module|ModuleNotFoundError|ImportError|cannot find symbol|compilation failed|syntax error|undefined: |No such file or directory|command not found|Permission denied|ENOENT|No tests found|No test files found|no tests ran|collected 0 items|Ran 0 tests'
blocked="$blocked|is not a function|is not defined|NameError|has no attribute|cannot find (function|value|type)|unresolved import"
blocked="$blocked|could not compile|NoMethodError|uninitialized constant|cannot find '.*' in scope|Unresolved reference|undeclared identifier"
# RSpec prints the class alone on a line and the message on the next, so such a header is joined with the
# next line first. NUL bytes become blanks and every grep reads text (-a): no grep may skip a binary log.
receiver="'NoneType' object has no attribute|undefined method .* for nil([ :]|\$)|NilClass"
# shellcheck disable=SC2016 # $0 is awk's, not the shell's
env LC_ALL=C tr '\000' ' ' < "$logs/without.log" |
  env LC_ALL=C awk '/^[[:space:]]*(NoMethodError|AttributeError):[[:space:]]*$/ { h = $0; if ((getline n) > 0) $0 = h " " n } { print }' > "$logs/joined"
{ grep -aEi "$blocked" "$logs/joined" || true; grep -a ': not found' "$logs/joined" || true; } |
  { grep -aEv "$receiver" || true; } > "$logs/blocked"
if [ -s "$logs/blocked" ]; then
  echo "probe: inconclusive (the test did not run without the guard: $(head -n 1 "$logs/blocked"))"
  exit 3
fi
if [ -n "$mutate" ]; then
  echo "probe: mutation caught ($(cat "$logs/mutated-line"))"
else
  echo "probe: fail-then-pass ok"
  tail -n 5 "$logs/without.log" >&2
fi
