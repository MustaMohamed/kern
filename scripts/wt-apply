#!/usr/bin/env bash
# Apply a binary-safe patch (wt-diff's <package>.patch) into a worktree, all or nothing.
# Usage: wt-apply PATCH DST_WT [--tree TREE]    Prints "applied". Exit 3 on conflict, with DST_WT unchanged.
# --tree: exit 2, with DST_WT unchanged, unless wt-diff's ${PATCH%.patch}.tree holds TREE, so the patch is
# the one that reached that tree.
set -euo pipefail
usage() { echo "usage: wt-apply PATCH DST_WT [--tree TREE]" >&2; exit 2; }
want=''
case "$#" in
  2) ;;
  4) [ "$3" = --tree ] && [ -n "$4" ] || usage; want=$4 ;;
  *) usage ;;
esac
patch=$1 dst=$2
[ -f "$patch" ] || { echo "wt-apply: no such patch: $patch" >&2; exit 2; }
git -C "$dst" rev-parse --git-dir > /dev/null 2>&1 || { echo "wt-apply: not a git worktree: $dst" >&2; exit 2; }
patch=$(cd "$(dirname "$patch")" && pwd -P)/$(basename "$patch")
if [ -n "$want" ]; then
  record=${patch%.patch}.tree
  [ -f "$record" ] || { echo "wt-apply: no tree record at $record; nothing applied" >&2; exit 2; }
  have=$(cat "$record")
  [ "$have" = "$want" ] || { echo "wt-apply: $record holds $have, not $want; nothing applied" >&2; exit 2; }
fi
# --whitespace=nowarn: the user's apply.whitespace (fix, error) must not change the reviewed bytes or
# report a conflict that does not exist.
if ! out=$(git -C "$dst" apply --whitespace=nowarn --check --binary "$patch" 2>&1); then
  echo "wt-apply: conflict, nothing applied:"
  printf '%s\n' "$out"
  exit 3
fi
git -C "$dst" apply --whitespace=nowarn --binary "$patch"
echo applied
