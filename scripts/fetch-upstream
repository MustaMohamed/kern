#!/usr/bin/env bash
# Fills .upstream/ with the pinned source trees that kern files are ported from. Dev-only; hooks never run it.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
dest="${KERN_UPSTREAM_DIR:-$root/.upstream}"
mkdir -p "$dest"

pin() { # key -> "url sha" for git sources
  case "$1" in
    superpowers) echo "https://github.com/obra/superpowers.git bb92a77741419a4ab5f06e711a283343f1ada0c3" ;;
    pstack) echo "https://github.com/cursor/plugins.git 182f2ce414e83224915c190d2f63239c1608d0a5" ;;
    pocock) echo "https://github.com/mattpocock/skills.git 49dd158d1076134a641b33efb035946536778336" ;;
    addy) echo "https://github.com/addyosmani/agent-skills.git aeac41d4d005999432bb7312f7ff06383a91d59d" ;;
    caveman) echo "https://github.com/JuliusBrussee/caveman.git d262ab3882952a59312ff3537cd86d894523c5ab" ;; # tag v4.0.1
    *) return 1 ;;
  esac
}

override() { # key suffix default
  local var
  var="KERN_UPSTREAM_$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')_$2"
  printf '%s' "${!var:-$3}"
}

clone_at() { # key url sha
  local key=$1 url=$2 sha=$3 dir="$dest/$1"
  if [ -d "$dir/.git" ]; then
    local want
    want=$(git -C "$dir" rev-parse --verify --quiet "$sha^{commit}" || true)
    if [ -n "$want" ] && [ "$(git -C "$dir" rev-parse HEAD)" = "$want" ]; then
      echo "$key: already at $sha"
      return 0
    fi
  fi
  rm -rf "$dir.new"
  if ! git clone --quiet "$url" "$dir.new"; then
    rm -rf "$dir.new"
    echo "$key: clone failed: $url" >&2
    return 3
  fi
  if ! git -C "$dir.new" checkout --quiet --detach "$sha" 2>/dev/null; then
    rm -rf "$dir.new"
    echo "$key: commit $sha not found in $url" >&2
    return 3
  fi
  rm -rf "$dir" && mv "$dir.new" "$dir"
  echo "$key: $url @ $sha"
}

copy_from() { # key src...
  local key=$1 dir="$dest/$1"
  shift
  rm -rf "$dir.new"
  if ! mkdir -p "$dir.new"; then
    echo "$key: cannot create $dir.new" >&2
    return 3
  fi
  local src
  for src in "$@"; do
    if [ ! -e "$src" ]; then
      rm -rf "$dir.new"
      echo "$key: source missing: $src" >&2
      return 3
    fi
    if ! cp -R "$src" "$dir.new"/; then
      rm -rf "$dir.new"
      echo "$key: copy failed: $src" >&2
      return 3
    fi
  done
  rm -rf "$dir" && mv "$dir.new" "$dir"
  echo "$key: copied"
}

fetch() {
  local key=$1 url sha
  if [ "$key" = caveman ] && [ -n "${KERN_UPSTREAM_CAVEMAN_SRC:-}" ]; then
    copy_from caveman "$KERN_UPSTREAM_CAVEMAN_SRC/."
    return
  fi
  case "$key" in
    superpowers|pstack|pocock|addy|caveman)
      read -r url sha <<<"$(pin "$key")"
      url=$(override "$key" URL "$url")
      sha=$(override "$key" SHA "$sha")
      local rc=0
      clone_at "$key" "$url" "$sha" || rc=$?
      if [ "$rc" -ne 0 ] && [ "$key" = superpowers ] && [ -z "${KERN_UPSTREAM_SUPERPOWERS_URL:-}" ]; then
        echo "superpowers: falling back to the installed cache" >&2
        copy_from superpowers "$HOME/.claude/plugins/cache/claude-plugins-official/superpowers/7.0.0/."
        return
      fi
      return "$rc"
      ;;
    local)
      local src
      src=$(override local SRC "")
      if [ -n "$src" ]; then
        copy_from local "$src/."
      else
        copy_from local "$HOME/.claude/skills/recall" "$HOME/.claude/skills/unslop" "$HOME/.claude/skills/no-comments" "$HOME/.claude/agents/comment-sicko.md"
      fi
      ;;
    *)
      echo "unknown source: $key (use superpowers pstack pocock addy caveman local)" >&2
      exit 2
      ;;
  esac
}

keys=("$@")
[ ${#keys[@]} -gt 0 ] || keys=(superpowers pstack pocock addy caveman local)
status=0
for k in "${keys[@]}"; do
  fetch "$k" || status=$?
done
exit "$status"
