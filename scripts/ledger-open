#!/usr/bin/env bash
# Open the execute-plan ledger for an approved plan, or check a ledger at the end of a run.
# Usage: ledger-open PLAN [DIR]    Prints the ledger dir. DIR defaults to WORK/ledgers/<plan slug>.
#        ledger-open --summary DIR Prints the Decision, parked, deferred-minor and Preflight lines, then
#                                  whether the main checkout's branch, HEAD and status are as recorded.
# A new ledger's header is `# kern ledger: <plan>`, `Plan: <git hash-object of the plan>` and `Main:`.
# Exit 2: the plan is not approved (status: approved and an approved: line with a date and the user's
# quoted words), the plan, the file a symlinked plan names, or its spec: line is not a Markdown name
# (G20 checks approvals only in Markdown files), the plan or its spec: is a working file (under
# WORK/ledgers, WORK/reviews or WORK/tmp, itself or through a symlink or ..; G20 lets the word approved
# into those) or is reached past 8 symlinks, a spec: holds .. after a directory that does not exist, a
# settings file that could set work_dir cannot be read, DIR holds another plan's ledger, or the plan's
# content differs from its ledger's Plan: line. Each refusal writes nothing; one about an existing
# ledger also prints `rerun as: bash .../ledger-open PLAN DIR-<n>`, the first free DIR-<n>. --summary
# exits 1 when the main checkout changed.
# Ledger identity adapted from superpowers subagent-driven-development/scripts/sdd-workspace (MIT).
set -euo pipefail
# The repository is the one the paths are in, not one the environment names.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR
here=$(cd "$(dirname "$0")" && pwd -P)
# shellcheck source=/dev/null
. "$here/../hooks/lib/settings.sh"
# shellcheck source=/dev/null
. "$here/lib/wt-common.sh"

# main_state: "<main root> branch=<name> head=<sha> status=<hash of git status --porcelain>".
main_state() {
  local m b h st
  m=$(kern_main_root "$PWD") || { echo "ledger-open: not a git repository" >&2; exit 2; }
  b=$(git -C "$m" symbolic-ref -q --short HEAD 2> /dev/null) || b='(detached)'
  h=$(git -C "$m" rev-parse -q --verify HEAD) || h='(unborn)'
  # Read first: a failing git status inside a pipe or printf argument would be hashed as empty input.
  st=$(git --no-optional-locks -C "$m" status --porcelain) || { echo "ledger-open: git status failed in $m" >&2; exit 2; }
  printf '%s branch=%s head=%s status=%s\n' "$m" "$b" "$h" "$({ [ -z "$st" ] || printf '%s\n' "$st"; } | git hash-object --stdin)"
}

# markdown NAME: exit 0 when NAME ends in .md or .markdown, in any case, as G20 reads a Markdown name.
markdown() {
  case "$1" in *.[Mm][Dd] | *.[Mm][Aa][Rr][Kk][Dd][Oo][Ww][Nn]) return 0 ;; esac
  return 1
}

# real_path FILE: absolute FILE with the longest part of its directory that exists read as the file
# system reads it: no .. and no symlink, in the directory's own case. cd -P reads a link/.. as the file
# system does, where a plain cd drops the link, and on macOS the pwd builtin keeps the case it was given.
# Exit 1 on a .. after a directory that does not exist, which names no known place.
real_path() {
  local d rest r
  case "$1" in /*) d=$1 ;; *) d=$PWD/$1 ;; esac
  rest=${d##*/}
  d=${d%/*}
  until r=$(cd -P "$d/" 2> /dev/null && env pwd -P); do
    [ -n "$d" ] || return 1
    rest=${d##*/}/$rest
    d=${d%/*}
  done
  case "/$rest" in */../* | */..) return 1 ;; esac
  printf '%s/%s\n' "${r%/}" "$rest"
}

# work_of DIR: the real path of the work dir of DIR's repository, found as kern-dir finds it. Prints
# nothing outside a repository, or for a work_dir kern-dir refuses, where G20 takes no file as a working
# file. Exit 2 when a settings file that could set work_dir cannot be read.
work_of() {
  local wd rc=0
  KERN_MAIN=$(kern_main_root "$1" 2> /dev/null) || return 0
  export KERN_MAIN
  wd=$(settings_get work_dir .kern) || rc=$?
  if [ "$rc" != 0 ]; then
    echo "ledger-open: work_dir is unknown: $(settings_unread_why work_dir)" >&2
    return 2
  fi
  wd=${wd%/}
  case "$wd" in '' | . | :* | .git | .git* | /* | *..*) return 0 ;; esac
  wd=$(real_path "$KERN_MAIN/$wd/.") || return 2
  printf '%s\n' "${wd%/.}"
}

# refuse_working WHAT FILE: exit 2 when FILE, or a symlink on the way to it, is under WORK/ledgers,
# WORK/reviews or WORK/tmp of this repository or the one that holds it. G20 lets the word approved into
# those files (_g20_working), so they are not plans or specs. WHAT names FILE in the refusal.
refuse_working() {
  local p=$2 i=0 mine w sub link
  while :; do
    p=$(real_path "$p") || { echo "ledger-open: cannot read the path of $1: it may hold a .. after a directory that does not exist" >&2; exit 2; }
    mine=$(work_of "$(dirname "$p")") || exit 2
    for w in "$work" "$mine"; do
      [ -n "$w" ] || continue
      for sub in ledgers reviews tmp; do
        case "$p" in
          "$w/$sub"/*)
            echo "ledger-open: $1 is a working file under $w/$sub; a plan or spec cannot live there" >&2
            exit 2
            ;;
        esac
      done
    done
    [ -L "$p" ] || return 0
    [ "$i" -lt 8 ] || { echo "ledger-open: $1 passes more than 8 symlinks, so it cannot show it is not a working file" >&2; exit 2; }
    link=$(readlink "$p") || { echo "ledger-open: cannot read the symlink $p" >&2; exit 2; }
    case "$link" in /*) p=$link ;; *) p=$(dirname "$p")/$link ;; esac
    i=$((i + 1))
  done
}

# free_dir: the first $dir-<n>, n from 2, that holds nothing and names no directory in worktree.dir. A
# new DIR is also a new <plan-slug> for execute-plan, so wt-new's worktree path is free too (a branch
# left from an earlier run of that slug is not checked; wt-new refuses it and says so).
free_dir() {
  local base=${dir%/} i=2 wtd=''
  if MAIN=$(kern_main_root "$PWD" 2> /dev/null); then
    export KERN_MAIN="$MAIN"
    wtd=$(wt_dir 2> /dev/null) || [ $? = 4 ]
  fi
  while [ -e "$base-$i" ] || { [ -n "$wtd" ] && [ -e "$wtd/$(basename "$base")-$i" ]; }; do i=$((i + 1)); done
  printf '%s\n' "$base-$i"
}

# refuse WHY: exit 2 on a ledger this plan cannot reuse, naming the command that opens a new one. execute-plan
# passes no DIR, so the model needs the whole command to relay or run.
refuse() {
  local new
  new=$(free_dir)
  echo "ledger-open: $1" >&2
  printf 'ledger-open: rerun as: bash %q %q %q\n' "$here/ledger-open" "$plan" "$new" >&2
  echo "ledger-open: that ledger starts empty: the completed tasks and the worktree of $ledger are not carried over, and stay where they are" >&2
  exit 2
}

if [ "${1-}" = --summary ]; then
  [ $# -eq 2 ] && [ -f "$2/ledger.md" ] || { echo "usage: ledger-open --summary DIR (DIR holds ledger.md)" >&2; exit 2; }
  grep -E '^(Decision:|parked:|Preflight:|Task [0-9]+: minor \(deferred\):)' "$2/ledger.md" || true
  rec=$(sed -n 's/^Main: //p' "$2/ledger.md" | head -n 1)
  now=$(main_state)
  if [ "$rec" = "$now" ]; then
    echo "main: unchanged"
    exit 0
  fi
  echo "main: changed; recorded $rec; now $now"
  exit 1
fi

[ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: ledger-open PLAN [DIR] | ledger-open --summary DIR" >&2; exit 2; }
plan=$1
[ -f "$plan" ] || { echo "ledger-open: no such plan: $plan" >&2; exit 2; }
plan=$(real_path "$plan") || { echo "ledger-open: cannot read the path of $plan" >&2; exit 2; }
# A plan named x.md that is a symlink to x.txt carries an approval G20 never saw, so the file it names
# must be Markdown too.
real=$plan
hops=0
while [ -L "$real" ] && [ "$hops" -lt 8 ]; do
  link=$(readlink "$real") || { echo "ledger-open: cannot read the symlink $real" >&2; exit 2; }
  case "$link" in /*) real=$link ;; *) real=$(dirname "$real")/$link ;; esac
  hops=$((hops + 1))
done
for name in "$plan" "$real"; do
  markdown "$name" || { echo "ledger-open: $name is not a Markdown file; G20 checks approvals only in .md files" >&2; exit 2; }
done
work=$(work_of "$PWD") || exit 2
refuse_working "$plan" "$plan"
# The frontmatter as G20 reads it (scripts/lib/frontmatter.awk), so an approval G20 never saw cannot
# open a ledger.
rc=0
fm=$(env LC_ALL=C awk -v fm_print=1 -f "$here/lib/frontmatter.awk" "$plan") || rc=$?
case "$rc" in
  0) ;;
  3) echo "ledger-open: $plan: frontmatter not closed" >&2; exit 2 ;;
  *) echo "ledger-open: could not read the frontmatter of $plan" >&2; exit 2 ;;
esac
spec=$(printf '%s\n' "$fm" | sed -n 's/^spec:[[:space:]]*//p' | head -n 1 | sed 's/[[:space:]]*$//')
case "$spec" in
  '' | none) ;;
  *)
    markdown "$spec" || { echo "ledger-open: $plan: spec: $spec is not a Markdown file; G20 checks approvals only in .md files" >&2; exit 2; }
    # Each place plan-check looks for the file; one that does not exist is still judged by its name.
    file=$spec
    case "$file" in WORK/*) file=$work/${file#WORK/} ;; esac
    main=$(kern_main_root "$PWD" 2> /dev/null) || main=''
    for c in "$file" "$(dirname "$plan")/$file" "$main/$file"; do
      refuse_working "$plan: spec: $spec" "$c"
    done
    ;;
esac
status=$(printf '%s\n' "$fm" | sed -n 's/^status:[[:space:]]*//p' | head -n 1)
approved=$(printf '%s\n' "$fm" | sed -n 's/^approved:[[:space:]]*//p' | head -n 1)
[ "$status" = approved ] || { echo "ledger-open: $plan has status: ${status:-none}; execute-plan runs only an approved plan" >&2; exit 2; }
printf '%s' "$approved" | grep -Eq '[0-9]{4}-[0-9]{2}-[0-9]{2}.*"[^"]+"' ||
  { echo "ledger-open: $plan has no approved: line with a date and the user's quoted words" >&2; exit 2; }

if [ $# -eq 2 ]; then
  dir=$2
else
  name=$(basename "$plan")
  slug=$(printf '%s\n' "${name%.*}" | tr '[:upper:]' '[:lower:]' | env LC_ALL=C sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//')
  [ -n "$slug" ] || { echo "ledger-open: cannot make a ledger name from $plan" >&2; exit 2; }
  dir=$(bash "$here/kern-dir" "ledgers/$slug")
fi
# The plan's content binds the ledger, so a plan updated in place and approved again does not reuse the
# complete lines of the tasks it had (audit C-I5). --no-filters hashes the bytes as they are.
hash=$(git hash-object --no-filters -- "$plan") || { echo "ledger-open: cannot hash $plan" >&2; exit 2; }
ledger="$dir/ledger.md"
if [ -f "$ledger" ]; then
  head=$(head -n 1 "$ledger")
  [ "$head" = "# kern ledger: $plan" ] ||
    refuse "$ledger belongs to another plan (${head#\# kern ledger: }); leave it and pass another DIR"
  rec=$(sed -n '2s/^Plan: //p' "$ledger")
  [ -n "$rec" ] || refuse "$ledger has no Plan: line, so it cannot show the plan is unchanged; pass another DIR"
  [ "$rec" = "$hash" ] || refuse "$ledger: the plan changed since this ledger opened; pass another DIR"
else
  MAIN=$(kern_main_root "$PWD") || { echo "ledger-open: not a git repository" >&2; exit 2; }
  export KERN_MAIN="$MAIN"
  # wt-new adds worktree.dir to info/exclude. Done here first, so untracked worktrees already in that dir
  # leave the recorded status, and the run does not end with a false "main: changed" (audit C-M3). A
  # worktree.dir that cannot be read whole gives the readable layers' answer, as wt_include takes it.
  wtd=$(wt_dir 2> /dev/null) || [ $? = 4 ]
  [ ! -d "$wtd" ] || wt_exclude_dir "$wtd"
  # Assigned first: a failure inside $(...) as a printf argument would not stop the script.
  state=$(main_state)
  mkdir -p "$dir"
  printf '# kern ledger: %s\nPlan: %s\nMain: %s\n' "$plan" "$hash" "$state" > "$ledger"
fi
mkdir -p "$dir/briefs" "$dir/reports" "$dir/reviews" "$dir/logs"
printf '%s\n' "$dir"
